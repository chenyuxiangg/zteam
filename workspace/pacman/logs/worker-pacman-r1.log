+│   ├── test_entities.py       # Mover 速度累积 + Player 缓冲 + Ghost 模式速度
+│   ├── test_input.py          # parse_key 映射
+│   ├── test_game.py           # T-GAME-01~18 对局闭环（吃豆/能量/反击/扣命/过关/结算）
+│   ├── test_dependency.py     # FR-19 / NFR-05 / NFR-06 零网络
+│   ├── test_renderer.py       # 渲染桩（无终端下的可测部分）
+│   ├── test_cli_smoke.py      # argparse + --help + 错误路径
+│   └── run_all.py             # 入口
+├── scripts/                   # 系统/性能/安全半自动脚本
+│   ├── ai_log_smoke.py        # --log-ai 行为日志通道（T-AI-09 客观验收）
