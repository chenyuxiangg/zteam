+        a = map_key(ord("w"), key_up=KEY_UP, key_left=KEY_LEFT, key_down=KEY_DOWN, key_right=KEY_RIGHT)
+        self.assertEqual(a, InputAction(Command.DIRECTION, Dir.UP))
