+        g.tick()
+        # 玩家 (12, 8) 是 DOT，吃到 → +10
+        self.assertEqual(g.score, 10)
+        self.assertEqual(g.dots_left, 215)
+        # tile 变 EMPTY
+        self.assertEqual(g.tiles[12][8], Tile.EMPTY)
+
+
+class TestPowerPellet(unittest.TestCase):
