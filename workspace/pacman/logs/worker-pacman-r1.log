+"""ad-hoc 验证 v3：pacman code-r1 关键行为抽测（最终版）。"""
+import sys, re, subprocess, os, tempfile
+ROOT = "/home/zyzs/cyx/zteam/workspace/pacman/code/pacman-r1"
+sys.path.insert(0, ROOT)
+
+passes, fails = 0, 0
+def check(name, ok, detail=""):
+    global passes, fails
+    if ok:
+        passes += 1
+        print(f"PASS  {name}")
+    else:
+        fails += 1
+        print(f"FAIL  {name}: {detail}")
+
+# --- 编译全部模块 ---
+r = subprocess.run(["python3", "-m", "compileall", "-q", "pacman"], cwd=ROOT, capture_output=True, text=True)
+check("compileall", r.returncode == 0, r.stderr[:200])
+
+# --- 1. 地图加载 + 三项离线判定 ---
+from pacman.map import load_map, MapError
+gm = load_map(os.path.join(ROOT, "pacman/data/map_classic.txt"))
+check("map 22x19", gm.rows == 19 and gm.cols == 22)
+check("map 216 dots", gm.initial_dots == 216)
+check("map spawn (12,9)", gm.player_spawn == (12, 9))
+check("map house 8 cells", len(gm.house_cells) == 8)
+
+try:
+    load_map("/nonexistent/path"); check("nonexistent 拦截", False, "未抛异常")
+except MapError as e:
+    check("nonexistent 拦截", "不存在" in str(e))
+
+# 行宽不一致：构造 5 行，前 4 行宽度 8，第 5 行宽度 5
+bad = tempfile.NamedTemporaryFile(mode="w", suffix=".txt", delete=False)
+bad.write("########\n#P.ooooo\n#..##HH-\n#..#####\n########\n#####\n"); bad.close()
+try:
+    load_map(bad.name); check("行宽不一致 拦截", False, "未抛异常")
+except MapError as e:
+    check("行宽不一致 拦截", "行宽" in str(e), f"got: {e}")
+os.unlink(bad.name)
+
+# 缺 P
+bad = tempfile.NamedTemporaryFile(mode="w", suffix=".txt", delete=False)
+bad.write("#####\n#..##\n#o..#\n##HH-\n#####\n"); bad.close()
+try:
+    load_map(bad.name); check("缺 P 拦截", False, "未抛异常")
+except MapError as e:
+    check("缺 P 拦截", "P" in str(e))
+os.unlink(bad.name)
+
+# --- 2. FR-10 主验收：四幽灵目标互异 ---
+from pacman.entities import Ghost, Player
+from pacman.ghost_ai import target_cell
+from pacman.config import Kind, Dir, Mode
+p = Player((5,5)); p.dir = Dir.RIGHT
+b = Ghost(Kind.BLINKY, (3,3))
+ghosts = [
+    (Kind.BLINKY, Ghost(Kind.BLINKY, (3,3))),
+    (Kind.PINKY,  Ghost(Kind.PINKY,  (3,4))),
+    (Kind.INKY,   Ghost(Kind.INKY,   (3,5))),
+    (Kind.CLYDE,  Ghost(Kind.CLYDE,  (3,6))),
+]
+ts_right = [target_cell(g, p, b, gm) for _, g in ghosts]
+check("FR-10 RIGHT 4 目标互异", len(set(ts_right)) == 4, f"got {ts_right}")
+p.dir = Dir.UP
+ts_up = [target_cell(g, p, b, gm) for _, g in ghosts]
+check("FR-10 UP 4 目标互异", len(set(ts_up)) == 4, f"got {ts_up}")
+
+# --- 3. Pinky UP-bug ---
+p.dir = Dir.UP; p.row, p.col = 5, 5
+got = target_cell(ghosts[1][1], p, b, gm)
+check("Pinky UP-bug (1,1)", got == (1, 1), f"got {got}")
+
+# --- 4. Inky 向量翻倍 ---
+p.dir = Dir.UP
+b1 = Ghost(Kind.BLINKY, (3, 10))
+b2 = Ghost(Kind.BLINKY, (8, 8))
+g1 = target_cell(ghosts[2][1], p, b1, gm)
