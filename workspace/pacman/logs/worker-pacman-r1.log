+"""Ad-hoc verification for pacman-r1 code-stage deliverable.
+
+Run from workspace/pacman/code/pacman-r1/ (PYTHONPATH=.).
+
+Each block prints PASS/FAIL with a one-line summary. The script is a
+snapshot of the manual checks done during the build (see README §9
+"开发者自检") and is NOT a replacement for the test-developer's full
+suite. It exercises the critical FR/NFR-anchored behavior with no
+external dependencies (curses is not imported; the logical layer is
+curses-free by design — NFR-02).
+"""
+
+import sys
+import tempfile
+import os
+import traceback
+
+PROD_ROOT = os.path.join(os.path.dirname(__file__), "..", "workspace", "pacman", "code", "pacman-r1")
+PROD_ROOT = os.path.abspath(PROD_ROOT)
+sys.path.insert(0, PROD_ROOT)
+
+results = []  # (id, status, msg)
+
+def check(test_id, fn):
+    try:
+        msg = fn() or ""
+        results.append((test_id, "PASS", msg))
+        print(f"[PASS] {test_id}: {msg}")
+    except AssertionError as e:
+        results.append((test_id, "FAIL", f"assert: {e}"))
+        print(f"[FAIL] {test_id}: assert: {e}")
+    except Exception as e:
+        results.append((test_id, "ERROR", f"{type(e).__name__}: {e}"))
+        print(f"[ERROR] {test_id}: {type(e).__name__}: {e}")
+        traceback.print_exc()
+
+
+# --------------------------------------------------------------------------
+# FR-02: Map — 19x22 / 216 dots / player_spawn (12, 9) / 8 house cells
+# --------------------------------------------------------------------------
+def t_fr02_map():
+    from pacman.map import load_map
+    gm = load_map("pacman/data/map_classic.txt")
+    assert gm.rows == 19, f"rows={gm.rows}"
+    assert gm.cols == 22, f"cols={gm.cols}"
+    assert gm.initial_dots == 216, f"dots={gm.initial_dots}"
+    assert gm.player_spawn == (12, 9), f"spawn={gm.player_spawn}"
+    assert len(gm.house_cells) == 8, f"house={len(gm.house_cells)}"
+    return f"19x22, 216 dots, spawn=(12,9), 8 house cells"
+
+check("FR-02 地图规格", t_fr02_map)
+
+
+# --------------------------------------------------------------------------
+# FR-10: target_cell — four ghosts have mutually different target tiles
+#         for the same game snapshot (main acceptance, objective)
+# --------------------------------------------------------------------------
+def t_fr10_target_diff():
+    from pacman.map import load_map
+    from pacman.entities import Ghost, Player
+    from pacman.ghost_ai import target_cell
+    from pacman.config import Kind, Dir
+    gm = load_map("pacman/data/map_classic.txt")
+    p = Player((5, 5)); p.dir = Dir.RIGHT
+    b = Ghost(Kind.BLINKY, (3, 3)); b.dir = Dir.RIGHT
+    ghosts = {
+        Kind.BLINKY: b,
+        Kind.PINKY:  Ghost(Kind.PINKY,  (3, 4)),
+        Kind.INKY:   Ghost(Kind.INKY,   (3, 5)),
+        Kind.CLYDE:  Ghost(Kind.CLYDE,  (3, 6)),
+    }
+    targets = {k.name: target_cell(g, p, b, gm) for k, g in ghosts.items()}
+    distinct = set(targets.values())
+    assert len(distinct) == 4, f"targets not 4-distinct: {targets}"
+    return f"targets={targets}"
+
+check("FR-10 四目标互异", t_fr10_target_diff)
+
