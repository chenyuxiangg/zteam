+
+class Dir(Enum):
+    UP = (-1, 0)
+    LEFT = (0, -1)
+    DOWN = (1, 0)
+    RIGHT = (0, 1)
+
+    @property
+    def delta(self) -> Tuple[int, int]:
+        return self.value
+
+    @property
+    def reverse(self) -> "Dir":
+        return {
+            Dir.UP: Dir.DOWN,
+            Dir.DOWN: Dir.UP,
+            Dir.LEFT: Dir.RIGHT,
+            Dir.RIGHT: Dir.LEFT,
+        }[self]
+
+
+class GhostKind(Enum):
