+  5. Normal motion still works: player (12,8) LEFT reaches (12,7)
+  6. DOOR passable for ghost but NOT for player (FR-05 + map semantics)
+  7. Speed accumulator resets acc when blocked (no phantom accumulation)
+  8. Ghost effective_speed unchanged (CHASE 0.9, FRIGHTENED 0.75)
+  9. Full unittest suite re-run as cross-check
+"""
+import os, sys, inspect, subprocess
+
+os.environ["PACMAN_CODE_DIR"] = "/home/zyzs/cyx/zteam/workspace/pacman/code/pacman-r2"
+sys.path.insert(0, "/home/zyzs/cyx/zteam/workspace/pacman/code/pacman-r2")
+sys.path.insert(0, "/home/zyzs/cyx/zteam/workspace/pacman/tests/pacman-r1")
+
+from pacman.config import Config, Dir, Kind, Mode
+from pacman.map import load_map
+from pacman.game import Game
+from pacman.entities import Player, Ghost, Mover
+
+GM = load_map("/home/zyzs/cyx/zteam/workspace/pacman/code/pacman-r2/pacman/data/map_classic.txt")
+
+results = []
+def check(name, ok, detail=""):
+    tag = "PASS" if ok else "FAIL"
+    results.append((tag, name, detail))
+    print(f"  [{tag}] {name}" + (f" -- {detail}" if detail else ""))
+
+# 1. Player.add_motion signature
+sig = inspect.signature(Player.add_motion)
+check("Player.add_motion accepts game_map",
+      "game_map" in sig.parameters,
+      f"sig={sig}")
+
+# 2. Mover.add_motion signature (base)
+sig2 = inspect.signature(Mover.add_motion)
+check("Mover.add_motion accepts optional game_map",
+      "game_map" in sig2.parameters,
+      f"sig={sig2}")
+
+# 3. Ghost.add_motion signature
+sig3 = inspect.signature(Ghost.add_motion)
+check("Ghost.add_motion signature accepts optional game_map",
+      "game_map" in sig3.parameters,
+      f"sig={sig3}")
+
+# 4. Wall collision (the r1 bug -- primary regression)
+g = Game(GM, Config())
+g.player.set_pos((7, 8)); g.player.dir = Dir.UP
+before = g.player.pos
+g.tick()
+check("Player (7,8) UP blocked by wall at (6,8)",
+      g.player.pos == before,
+      f"pos={g.player.pos}, expected={before}")
+
+# 5. Normal motion regression-free
+g2 = Game(GM, Config())
+g2.player.set_pos((12, 8)); g2.player.dir = Dir.LEFT
+g2.tick()
+check("Player (12,8) LEFT moves to (12,7)",
+      g2.player.pos == (12, 7),
+      f"pos={g2.player.pos}")
+
+# 6. DOOR/HOUSE passability: player vs ghost
+check("Player cannot enter DOOR tile (10,9)",
