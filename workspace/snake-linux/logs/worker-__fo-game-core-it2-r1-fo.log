+"""Ad-hoc verification for game-core iter-2 TDD deliverable.
+
+Runs the UT suite and asserts coverage ≥95% (per design §5.5).
+"""
+import os
+import subprocess
+import sys
+
+ROOT = "/home/zyzs/cyx/zteam/workspace/snake-linux/code/game-core/iter-2"
+
+
+def run(cmd, cwd=ROOT):
+    print(f"\n$ {' '.join(cmd)}")
+    r = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
+    print(r.stdout)
+    if r.returncode != 0:
+        print("STDERR:", r.stderr, file=sys.stderr)
+    return r
+
+
+def main():
+    # 1) UT 全套
+    r = run([
+        "python3", "-m", "unittest", "discover",
+        "-s", "tests/test_game_core", "-v",
+    ])
+    assert r.returncode == 0, "UT 全套未通过"
+    # 输出最后一行应含 Ran N tests
+    last = r.stdout.strip().splitlines()[-1]
+    assert last.startswith("Ran ") and "OK" in r.stdout, f"UT 输出异常：{last}"
+
+    # 2) 覆盖率达到设计目标 (state.py/params.py 100%, total >=95%)
+    run([
+        "python3", "-m", "coverage", "run", "--source=game_core",
+        "--branch", "-m", "unittest", "discover", "-s", "tests/test_game_core",
+    ])
+    r = run([
+        "python3", "-m", "coverage", "report", "--include=game_core/*",
+    ])
+    assert r.returncode == 0
+    # 抓 total 行
+    total_line = [l for l in r.stdout.splitlines() if l.startswith("TOTAL")]
+    assert total_line, "coverage report 缺少 TOTAL 行"
+    cover_pct = int(total_line[0].split()[-1].rstrip("%"))
+    assert cover_pct >= 95, f"覆盖率 {cover_pct}% < 95%"
+    print(f"\n覆盖率 OK: {cover_pct}%")
+
+    # 3) 公共 API 检查（无残留 DirectionError）
+    code = (
+        "import game_core\n"
+        "assert not hasattr(game_core, 'DirectionError'), 'DirectionError 必须删除'\n"
+        "assert hasattr(game_core, 'speed_curve')\n"
+        "assert hasattr(game_core, 'MIN_TICK_MS')\n"
+        "assert hasattr(game_core, 'ScoreCallback')\n"
+        "print('import OK')\n"
+    )
+    r = run(["python3", "-c", code])
+    assert r.returncode == 0, "API 暴露不完整"
+
+    # 4) INV-10 抽样验证（NFR-01 量化）
+    code = (
+        "from game_core import Difficulty, speed_curve, MIN_TICK_MS\n"
+        "assert speed_curve(0, Difficulty.EASY) == 250\n"
+        "assert speed_curve(0, Difficulty.MEDIUM) == 160\n"
+        "assert speed_curve(0, Difficulty.HARD) == 100\n"
+        "assert MIN_TICK_MS == {Difficulty.EASY: 100, Difficulty.MEDIUM: 80, Difficulty.HARD: 50}\n"
