+"""Debug test for closure identity issue."""
+from unittest.mock import MagicMock
+
+
+class App:
+    def __init__(self):
+        self._storage = None
+
+    def new_game(self):
+        if self._storage is None:
+            cb = None
+        else:
+            _storage = self._storage
+            def cb(score):
+                return score
+            return cb
+
+
+def main():
+    a = App()
+    a._storage = MagicMock()
+    f1 = a.new_game()
+    f2 = a.new_game()
+    print(f"f1 = {f1}, id = {id(f1)}")
+    print(f"f2 = {f2}, id = {id(f2)}")
+    print(f"same? {f1 is f2}")
+
+
+if __name__ == "__main__":
+    main()
