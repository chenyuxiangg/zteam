+"""step 撞自身测试：头撞非尾身段 → OVER。"""
+import unittest
+import random
+from game_core import GameState, Difficulty, Point, GameStatus, Direction
+
+
+class _Base(unittest.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.rng = random.Random(42)
+
+
+class TestStepCollideSelf(_Base):
+    """UT #5"""
+
+    def test_hits_non_tail_body_segment(self):
+        # 5x5：body=[(2,2),(1,2),(0,2)]，让蛇往右走几步，再 DOWN/LEFT 让头撞身体中段
+        s = GameState(width=5, height=5, difficulty=Difficulty.MEDIUM, rng=self.rng)
+        # RIGHT 1 步：body=[(3,2),(2,2),(1,2)]
+        s = s.step()
+        # DOWN：pending=down，蛇头从 (3,2) -> (3,3)
+        s = s.set_direction(Direction.DOWN).step()
+        # LEFT：蛇头从 (3,3) -> (2,3)，身体已有 (2,2)，但不撞（y 不同）
+        s = s.set_direction(Direction.LEFT).step()
+        # UP：蛇头从 (2,3) -> (2,2)，(2,2) 在 body 里且不是尾
+        # 当前 body=[(2,3),(3,3),(3,2),(2,2)]，尾=(2,2) 恰好是 new_head——撞尾（不吃食）让行，不 OVER
+        # 所以换个构造：让身体形成 U 形后撞
+        # 重新构造：5x5，先走到右上角再 LEFT/DOWN/UP
+        s = GameState(width=5, height=5, difficulty=Difficulty.MEDIUM, rng=random.Random(99))
+        # 默认 RIGHT，先 set UP 让蛇往上走 3 步撞墙不行；改用更宽网格让蛇走 U 形
+        s = GameState(width=6, height=6, difficulty=Difficulty.MEDIUM, rng=random.Random(7))
+        # body=[(3,3),(2,3),(1,3)] 朝右；走 1 步 RIGHT -> [(4,3),(3,3),(2,3)]
+        s = s.step()
+        # DOWN 3 步：[(4,4),(3,3)...], [(4,5),(4,4),...], [(4,6) 出界 OVER]
+        # 改：DOWN 1 步：[(4,4),(4,3),(3,3)] 然后 LEFT 1 步：[(3,4),(4,4),(4,3)] UP 1 步：[(3,3),(3,4),(4,4)]
+        # 这时 body[(0,1,2)]=[(3,3),(3,4),(4,4)]；下一步 LEFT=撞 (3,4) 中段 OVER
+        s = s.set_direction(Direction.DOWN).step()
+        s = s.set_direction(Direction.LEFT).step()
+        s = s.set_direction(Direction.UP).step()
+        # 现在 body=[(3,3),(3,4),(4,4)] 头在 (3,3)；下一步 LEFT 头到 (2,3)，不撞
+        # 再 set RIGHT 撞 (3,3) 但 (3,3) 是头——不算撞；再 set DOWN 撞 (3,4) 中段 OVER
+        s_over = s.set_direction(Direction.DOWN).step()
+        self.assertEqual(s_over.status, GameStatus.OVER)
+
+
+if __name__ == "__main__":
+    unittest.main()
