+"""step 撞尾测试：v1 一致行为——
+撞尾（不吃食）→ 不结束（让行）
+撞尾（吃食）→ OVER
+"""
+import unittest
+import random
+from game_core import GameState, Difficulty, Point, GameStatus, Direction, Food
+from dataclasses import replace
+
+
+class _Base(unittest.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.rng = random.Random(42)
+
+
+class TestStepCollideTail(_Base):
+    """UT #6 + #6b"""
+
+    def test_hits_tail_without_eat_keeps_running(self):
+        # 5x5：body=[(2,2),(1,2),(0,2)] 朝右；让蛇先 DOWN 让蛇变成竖直
+        # 但 set_direction(LEFT) 反向被禁止；改用 4x4 测：让蛇走 U 形
+        s = GameState(width=5, height=5, difficulty=Difficulty.MEDIUM, rng=random.Random(1))
+        # body=[(2,2),(1,2),(0,2)] 朝右
+        # 1) RIGHT 1 步 -> [(3,2),(2,2),(1,2)] 尾=(1,2)
+        s = s.step()
+        # 2) DOWN 1 步 -> [(3,3),(3,2),(2,2)] 尾=(2,2)
+        s = s.set_direction(Direction.DOWN).step()
+        # 3) LEFT 1 步 -> [(2,3),(3,3),(3,2)] 尾=(3,2)
+        s = s.set_direction(Direction.LEFT).step()
+        # 4) UP 1 步 -> [(2,2),(2,3),(3,3)] 尾=(3,3)
+        s = s.set_direction(Direction.UP).step()
+        # 现在 body=[(2,2),(2,3),(3,3)] 头=(2,2)；下一步 DOWN 头=(2,3) 撞身体中段 OVER
+        # 要构造"撞尾不吃食"：让下一步头=旧尾，且旧尾即将移走
+        # 5x5 边界紧不好做，改用 6x6 + 蛇更长
+        s = GameState(width=6, height=6, difficulty=Difficulty.MEDIUM, rng=random.Random(2))
+        # body=[(3,3),(2,3),(1,3)] 朝右
+        # RIGHT 2 步 -> body=[(5,3),(4,3),(3,3)] 尾=(3,3)
+        s = s.step().step()
+        # DOWN 1 步 -> [(5,4),(5,3),(4,3)] 尾=(4,3)
+        s = s.set_direction(Direction.DOWN).step()
+        # LEFT 1 步 -> [(4,4),(5,4),(5,3)] 尾=(5,3)
+        s = s.set_direction(Direction.LEFT).step()
+        # UP 2 步 -> [(4,3),(4,4),(5,4)] 尾=(5,4)；再 UP -> [(4,2),(4,3),(4,4)]
+        s = s.set_direction(Direction.UP).step().step()
+        # body=[(4,2),(4,3),(4,4)]，下一步 LEFT 头=(3,2) 不撞
+        # set DOWN 1 步：[(4,3),(4,2),(4,3)] — 等等头会撞 (4,3) 中段 OVER
+        # 重新构造：U 形更松
+        # 简单做法：构造 L 形，蛇长 4 让下一步头撞尾
+        # 7x7 让蛇长到 4：
+        s = GameState(width=7, height=7, difficulty=Difficulty.MEDIUM, rng=random.Random(3))
+        # body=[(3,3),(2,3),(1,3)] 朝右
+        # RIGHT 3 步 -> [(6,3),(5,3),(4,3)] 尾=(4,3)
+        s = s.step().step().step()
+        # DOWN 2 步 -> [(6,5),(6,4),(6,3)] 尾=(6,3)
+        s = s.set_direction(Direction.DOWN).step().step()
+        # LEFT 1 步 -> [(5,5),(6,5),(6,4)] 尾=(6,4)
+        s = s.set_direction(Direction.LEFT).step()
+        # UP 1 步 -> [(5,4),(5,5),(6,5)] 尾=(6,5)
+        s = s.set_direction(Direction.UP).step()
+        # DOWN 1 步 -> [(5,5),(5,4),(5,5)]? 不对，蛇头去 (5,5) 撞 (5,5) 中段
+        # 重新精确推演：
+        # 当前 body=[(5,4),(5,5),(6,5)] 头=(5,4)，下一步 DOWN 头=(5,5)
+        # (5,5) 是 body[1] 中段 OVER，不是撞尾
+        # 算了，直接用 monkey patch 构造精确场景：蛇长 2，"朝左"反向禁止绕过去
+        # 改用 set_direction 反向被禁的 bug 路径：长度 1 反向特例
