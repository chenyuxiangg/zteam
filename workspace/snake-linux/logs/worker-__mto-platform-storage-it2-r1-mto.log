+"""Ad-hoc verification: run the platform-storage IT suite and summarize.
+
+Hermes-verify- prefix per ad-hoc verification convention.
+Uses tempfile path (already under /tmp, OS-safe).
+Cleans itself up after run.
+"""
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+# Locate workspace deterministically (not hardcoded user path)
+WS_ROOT = Path("/home/zyzs/cyx/zteam")
+IT_DIR = WS_ROOT / "workspace/snake-linux/it/platform-storage/iter-2"
+TEST_FILE = IT_DIR / "test_it_storage_2.py"
+CODE_ROOT = WS_ROOT / "workspace/snake-linux/code/platform-storage/iter-2"
+
+if not TEST_FILE.exists():
+    print(f"FAIL: test file missing: {TEST_FILE}")
+    sys.exit(2)
+if not CODE_ROOT.exists():
+    print(f"FAIL: code root missing: {CODE_ROOT}")
+    sys.exit(2)
+
+# Run pytest against the changed test file with junitxml
+junit_path = Path(tempfile.gettempdir()) / "hermes-verify-it-storage2-junit.xml"
+cmd = [
+    "python3", "-m", "pytest", "-v",
+    str(TEST_FILE),
+    f"--junitxml={junit_path}",
+]
+proc = subprocess.run(cmd, cwd=str(CODE_ROOT), capture_output=True, text=True, timeout=120)
+print("=== STDOUT ===")
+print(proc.stdout[-2000:])
+if proc.stderr:
+    print("=== STDERR ===")
+    print(proc.stderr[-1000:])
+
+# Parse junit for pass/fail counts (canonical evidence, not self-report)
+import xml.etree.ElementTree as ET
+tree = ET.parse(junit_path)
+suite = tree.getroot().get("testsuite") or tree.find("testsuite")
+tests = int(suite.get("tests", "0"))
+failures = int(suite.get("failures", "0"))
+errors = int(suite.get("errors", "0"))
+skipped = int(suite.get("skipped", "0"))
+passed = tests - failures - errors - skipped
+print(f"=== JUNIT XML ===")
+print(f"tests={tests} passed={passed} failures={failures} errors={errors} skipped={skipped}")
+
+# Sanity: also re-collect just the test ids (proves the file is real, not fabricated)
+collected = subprocess.run(
