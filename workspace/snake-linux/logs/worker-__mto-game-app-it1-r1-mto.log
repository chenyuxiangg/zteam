+"""Ad-hoc verification for MTO IT of snake-linux/game-app iter-1.
+
+NOT a permanent test — only proves the 50-case IT suite still passes after the
+final edits to test_it_game_app_1.py. Use the suite itself (it-report.xml) as
+the canonical evidence; this script is just a self-contained re-run with an
+explicit assertion message.
+"""
+from __future__ import annotations
+
+import subprocess
+import sys
+from pathlib import Path
+
+IT_DIR = Path("/home/zyzs/cyx/zteam/workspace/snake-linux/it/game-app/iter-1")
+TEST_FILE = IT_DIR / "test_it_game_app_1.py"
+REPORT_XML = IT_DIR / "it-report.xml"
+
+assert TEST_FILE.exists(), f"missing test file: {TEST_FILE}"
+
+# Run pytest against the IT file with junitxml output (overwrites existing).
+cmd = [
+    sys.executable, "-m", "pytest",
+    str(TEST_FILE),
+    "-v", "--tb=short",
+    f"--junitxml={REPORT_XML}",
+]
+result = subprocess.run(cmd, capture_output=True, text=True, cwd=str(IT_DIR))
+
+print("=== STDOUT (tail) ===")
+print("\n".join(result.stdout.splitlines()[-15:]))
+print("=== STDERR (tail) ===")
+print("\n".join(result.stderr.splitlines()[-5:]) if result.stderr else "(empty)")
+print(f"=== exit_code: {result.returncode} ===")
+
+# Parse the summary line to confirm 50 passed / 0 failed.
+passed = failed = 0
+for line in result.stdout.splitlines():
+    line = line.strip()
+    if "passed" in line or "failed" in line:
+        # e.g. "============================== 50 passed in 0.42s =============================="
+        parts = line.split()
+        for i, tok in enumerate(parts):
+            if tok == "passed" and i > 0:
+                try:
+                    passed = int(parts[i - 1])
+                except ValueError:
+                    pass
+            if tok == "failed" and i > 0:
+                try:
+                    failed = int(parts[i - 1])
+                except ValueError:
+                    pass
+
+assert result.returncode == 0, f"pytest exit {result.returncode}"
+assert passed == 50, f"expected 50 passed, got {passed}"
+assert failed == 0, f"expected 0 failed, got {failed}"
+assert REPORT_XML.exists(), f"missing junitxml: {REPORT_XML}"
+
+print(f"\nAD-HOC VERIFY OK: {passed} passed / {failed} failed, junitxml at {REPORT_XML}")
