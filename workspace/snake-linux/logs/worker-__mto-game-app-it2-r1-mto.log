+#!/bin/bash
+# Hermes ad-hoc verification for game-app iter-2 IT
+# Runs the just-written IT test file end-to-end and prints a focused PASS/FAIL summary.
+set -u
+
+WORKSPACE=/home/zyzs/cyx/zteam/workspace/snake-linux
+TEST_FILE="$WORKSPACE/it/game-app/iter-2/test_it_game_app_2.py"
+JUNIT="$WORKSPACE/it/game-app/iter-2/it-report.xml"
+
+if [ ! -f "$TEST_FILE" ]; then
+  echo "VERIFY:FAIL: test file missing at $TEST_FILE"
+  exit 2
+fi
+
+cd "$WORKSPACE" || { echo "VERIFY:FAIL: cannot cd to workspace"; exit 2; }
+
+echo "==> pytest run (full file)"
+python3 -m pytest "$TEST_FILE" \
+  --tb=short \
+  -W ignore::pytest.PytestUnknownMarkWarning \
+  --junitxml="$JUNIT" 2>&1 | tail -15
+PYTEST_RC=${PIPESTATUS[0]}
+
+echo ""
+echo "==> priority breakdown"
+python3 -m pytest "$TEST_FILE" -m "p0" -q -W ignore::pytest.PytestUnknownMarkWarning 2>&1 | tail -3
+P0_RC=${PIPESTATUS[0]}
+
+python3 -m pytest "$TEST_FILE" -m "p1" -q -W ignore::pytest.PytestUnknownMarkWarning 2>&1 | tail -3
+P1_RC=${PIPESTATUS[0]}
+
+echo ""
+echo "==> junitxml summary"
+python3 - <<'PY'
+import xml.etree.ElementTree as ET, os
+p = "/home/zyzs/cyx/zteam/workspace/snake-linux/it/game-app/iter-2/it-report.xml"
+if not os.path.exists(p):
+    print("junitxml: missing")
+else:
+    t = ET.parse(p).getroot()
+    suite = t.attrib
+    print(f"tests={suite.get('tests')} failures={suite.get('failures')} errors={suite.get('errors')} skipped={suite.get('skipped')}")
+PY
+
+echo ""
+if [ "$PYTEST_RC" = "0" ] && [ "$P0_RC" = "0" ] && [ "$P1_RC" = "0" ]; then
+  echo "VERIFY:PASS"
+else
+  echo "VERIFY:FAIL (pytest=$PYTEST_RC p0=$P0_RC p1=$P1_RC)"
+fi
