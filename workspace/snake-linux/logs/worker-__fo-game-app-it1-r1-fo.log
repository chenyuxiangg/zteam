+#!/usr/bin/env bash
+# hermes-verify-game-app-fo.sh — FO 交付 ad-hoc 验证
+# 范围：conftest.py 改动（fake_pygame 同步 patch gui_renderer.renderer） +
+#      game-app iter-1 全量 UT + release_module 状态迁移审计
+set -euo pipefail
+
+WS=/home/zyzs/cyx/zteam/workspace/snake-linux
+ITER_DIR=$WS/code/game-app/iter-1
+
+echo "==[1/4] conftest.py 改动落地检查 =="
+grep -n "gui_renderer.renderer" "$ITER_DIR/tests/test_game_app/conftest.py" \
+  || { echo "FAIL: 改动未生效"; exit 1; }
+echo "  OK: conftest 已 patch gui_renderer.renderer.pygame"
+
+echo ""
+echo "==[2/4] pytest 全量 =="
+cd "$ITER_DIR"
+python3 -m pytest tests/ -q 2>&1 | tail -8
+# 取出 pass/fail 数字再断言
+RESULT=$(python3 -m pytest tests/ -q 2>&1 | tail -1)
+echo "  RESULT: $RESULT"
+case "$RESULT" in
+  *"132 passed"*) echo "  OK: 132/132 pass" ;;
+  *) echo "  FAIL: $RESULT"; exit 2 ;;
+esac
+
+echo ""
+echo "==[3/4] release_module 状态已置 dev_reviewing =="
+grep -E "MODULE_CODE snake-linux/game-app iter-1 DONE" /home/zyzs/cyx/zteam/workspace/logs/pipeline.log \
+  | tail -1 \
+  || { echo "FAIL: 无 MODULE_CODE DONE 审计行"; exit 3; }
+
+python3 -c "
+import json, sys
+d = json.load(open('$WS/modules.json'))
+for m in d['modules']:
+    if m['name'] == 'game-app':
+        it = m['iterations'][0]
+        print(f\"  iter-1.status = {it['status']}\")
+        print(f\"  iter-1.dev_product = {it['dev_product']}\")
+        assert it['status'] == 'dev_reviewing', it['status']
+        assert it['dev_product'] == 'snake-linux/code/game-app/iter-1/', it['dev_product']
+        print('  OK: status=dev_reviewing + dev_product 正确')
+"
+
+echo ""
+echo "==[4/4] 关键不变量抽查（pygame.quit 调用次数） =="
+# 直跑 test_app_exit 的两个核心用例，确认 conftest 改动真让 fake 生效
+python3 -m pytest tests/test_game_app/test_app_exit.py::TestRendererShutdownOnExit \
+                  tests/test_game_app/test_app_exit.py::TestGraphicsUnavailableError \
+                  tests/test_game_app/test_app_exit.py::TestNoQuitMethod -v 2>&1 | tail -8
+
+echo ""
+echo "== ALL VERIFY PASS =="

