+"""config 模块：AppConfig 运行期不可变常量。
+
+FR-09/NFR-01/NFR-02 量化：640×480 默认窗口、60 FPS 目标、最小可玩尺寸 512×472。
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from .errors import ConfigError
+
+
+@dataclass(frozen=True)
+class AppConfig:
+    """运行期不可变常量。
+
+    INV：fps_cap > 0；window_w >= min_window_w；window_h >= min_window_h。
+    """
+
+    window_w: int = 640        # 与 gui-renderer.constants.WINDOW_WIDTH 一致
+    window_h: int = 480        # 与 gui-renderer.constants.WINDOW_HEIGHT 一致
+    fps_cap: int = 60          # NFR-01 帧率目标
+    min_window_w: int = 512    # gui-renderer 最小可玩宽度 = GRID_COLS * CELL_SIZE + 2 * PLAYFIELD_X
+    min_window_h: int = 472    # gui-renderer 最小可玩高度 = PLAYFIELD_Y + GRID_ROWS * CELL_SIZE + PLAYFIELD_X
+
+    def __post_init__(self) -> None:
+        if self.fps_cap <= 0:
+            raise ConfigError(
+                f"fps_cap 必须 > 0，收到 {self.fps_cap}"
+            )
+        if self.window_w < self.min_window_w:
+            raise ConfigError(
+                f"window_w={self.window_w} < min_window_w={self.min_window_w}"
+            )
+        if self.window_h < self.min_window_h:
+            raise ConfigError(
+                f"window_h={self.window_h} < min_window_h={self.min_window_h}"
+            )
+
+
+__all__ = ["AppConfig"]
