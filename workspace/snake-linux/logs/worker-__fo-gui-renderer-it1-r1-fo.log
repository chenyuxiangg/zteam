+
+    调用记录在类级 list，UT 可在断言前/后读写。
+    """
+
+    display = None
+    draw = None
+    font = None
+    time = None
+    init_calls = 0
+    quit_calls = 0
+
+    def __init__(self) -> None:
+        raise RuntimeError("FakePygame 应作为命名空间使用，不要实例化")
+
+    @classmethod
