+"""hermes-verify-gui-renderer-iter1：gui-renderer 迭代 1 一次性验证脚本。
+
+运行：pytest 全套 + 覆盖率 + 模块导入冒烟 + 网络/磁盘隔离校验。
+退出码：0 = 全绿；非 0 = 有失败。
+"""
+import os
+import subprocess
+import sys
+import tempfile
+
+PROJECT_ROOT = "/home/zyzs/cyx/zteam/workspace/snake-linux/code/gui-renderer/iter-1"
+
+
+def run(label: str, cmd: list[str], cwd: str = PROJECT_ROOT) -> tuple[int, str]:
+    print(f"\n=== {label} ===\n$ {' '.join(cmd)}")
+    proc = subprocess.run(
+        cmd,
+        cwd=cwd,
+        capture_output=True,
+        text=True,
+        timeout=120,
+    )
+    out = (proc.stdout or "") + (proc.stderr or "")
+    print(out)
+    print(f"--- exit={proc.returncode} ---")
+    return proc.returncode, out
+
+
+def main() -> int:
+    # 1. 全套 pytest（含覆盖率）
+    rc, out = run(
+        "1) pytest 全套 + 覆盖率",
+        ["python3", "-m", "pytest", "tests/", "-v",
+         "--cov=gui_renderer", "--cov-branch",
+         "--cov-report=term-missing"],
+    )
+    if rc != 0:
+        print("VERIFICATION FAIL: pytest")
+        return rc
+
+    # 2. 覆盖率阈值校验（设计 §7.2 要求 ≥90%）
+    if "100%" not in out.split("TOTAL")[-1].split("\n")[1] if "TOTAL" in out else "":
