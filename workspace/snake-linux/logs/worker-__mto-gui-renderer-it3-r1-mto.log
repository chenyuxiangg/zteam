+"""Ad-hoc verification for gui-renderer iter-3 IT changes.
+
+Re-runs pytest on the changed test file and reports pass/fail counts.
+"""
+import subprocess
+import sys
+from pathlib import Path
+
+TEST_DIR = Path("/home/zyzs/cyx/zteam/workspace/snake-linux/it/gui-renderer/iter-3")
+TEST_FILE = TEST_DIR / "test_it_gui_renderer_3.py"
+
+if not TEST_FILE.exists():
+    print(f"BLOCKER: test file not found at {TEST_FILE}", file=sys.stderr)
+    sys.exit(2)
+
+proc = subprocess.run(
+    [sys.executable, "-m", "pytest", str(TEST_FILE), "-v", "--tb=short"],
+    cwd=str(TEST_DIR),
+    capture_output=True,
+    text=True,
+    timeout=120,
+)
+
+print("=== STDOUT (tail) ===")
+lines = proc.stdout.splitlines()
+for line in lines[-65:]:
+    print(line)
+
+print(f"\n=== EXIT CODE: {proc.returncode} ===")
+
+# Quick assertion: summary line
+summary_lines = [l for l in proc.stdout.splitlines() if "passed" in l and "warning" in l]
+if summary_lines:
+    print(f"SUMMARY: {summary_lines[-1]}")
+    if proc.returncode == 0 and "53 passed" in summary_lines[-1]:
+        print("VERIFICATION: 53/53 passed (ad-hoc rerun)")
+        sys.exit(0)
+    else:
+        print("VERIFICATION: unexpected result", file=sys.stderr)
+        sys.exit(1)
+else:
+    print("VERIFICATION: no summary line found", file=sys.stderr)
+    sys.exit(1)

