+#!/usr/bin/env python3
+"""Ad-hoc verification for st/v2.0.0/test_st_v2_0_0.py (last edit: ST-09 skin-cycle assertion).
+
+Runs the full ST pytest suite against the final edited test file and reports
+exit code + pass/fail counts. This is ad-hoc verification, not a canonical
+repo test command (the pipeline has no registered test entry for ST).
+"""
+import os
+import subprocess
+import sys
+import tempfile
+
+ZTEAM = "/home/zyzs/cyx/zteam"
+CODE = [
+    "workspace/snake-linux/code/game-core/iter-2",
+    "workspace/snake-linux/code/gui-renderer/iter-3",
+    "workspace/snake-linux/code/platform-storage/iter-2",
+    "workspace/snake-linux/code/game-app/iter-4",
+]
+TEST = "workspace/snake-linux/st/v2.0.0/test_st_v2_0_0.py"
+
+env = os.environ.copy()
+env["SDL_VIDEODRIVER"] = "dummy"
+env["SDL_AUDIODRIVER"] = "dummy"
+env["PYTHONPATH"] = os.pathsep.join(CODE)
+
+fd, xml_path = tempfile.mkstemp(prefix="hermes-verify-", suffix=".xml")
+os.close(fd)
+
+try:
+    r = subprocess.run(
+        [sys.executable, "-m", "pytest", TEST, "-q", "--tb=short",
+         "--junitxml=" + xml_path],
+        capture_output=True, text=True, timeout=600, env=env, cwd=ZTEAM,
+    )
+    tail = (r.stdout + r.stderr).strip().splitlines()
+    summary = [ln for ln in tail if "passed" in ln or "failed" in ln or "error" in ln]
+    print("=== ST suite result ===")
+    print("exit_code:", r.returncode)
+    print("summary:", summary[-1] if summary else "(no summary)")
+    if r.returncode != 0:
+        print("--- failures ---")
+        for ln in r.stdout.splitlines():
+            if ln.startswith("FAILED") or ln.startswith("ERROR"):
+                print(ln)
+    sys.exit(0 if r.returncode == 0 else 1)
+finally:
+    try:
+        os.remove(xml_path)
+    except OSError:
+        pass

