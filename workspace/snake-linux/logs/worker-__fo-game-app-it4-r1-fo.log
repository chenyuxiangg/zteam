+            "p50_frame_ms": float,
+            "p95_frame_ms": float,
+            "p99_frame_ms": float,
+            "input_latency_ms": float,
+            "duration_s": int,
+            "result": "PASS" | "FAIL",
+        }
+    """
+    config = AppConfigV3(enable_high_dpi=True)
