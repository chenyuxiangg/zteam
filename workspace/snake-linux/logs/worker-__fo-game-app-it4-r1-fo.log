+ASSET = "/home/zyzs/cyx/zteam/snake-linux"
+fails = []
+
+
+def check(name, ok, detail=""):
+    status = "PASS" if ok else "FAIL"
+    print(f"[{status}] {name}" + (f" — {detail}" if detail else ""))
+    if not ok:
+        fails.append(name)
+
+
+# ---------- 1. 全量 UT ----------
+r = subprocess.run(
+    [sys.executable, "-m", "pytest", "tests/", "-q"],
+    cwd=ITER4, capture_output=True, text=True, timeout=300,
+)
+check("UT 全量（186 passed）", "186 passed" in r.stdout + r.stderr,
+      (r.stdout + r.stderr).strip().splitlines()[-1].strip() if r.returncode else "186 passed")
+
+# ---------- 2. F-1：spec 探测（PyInstaller 桩执行） ----------
+spec_dir = os.path.join(ASSET, "spec")
+spec_src = open(os.path.join(spec_dir, "snake-gui.spec"), encoding="utf-8").read()
+ns = {"SPECPATH": spec_dir}
+class FakeA:
+    def __init__(self, *a, **k):
+        self.pathex = k.get("pathex", [])
+        self.pure = self.zipped_data = self.scripts = self.binaries = self.zipfiles = self.datas = []
+ns["Analysis"] = lambda *a, **k: FakeA(*a, **k)
+ns["PYZ"] = lambda *a, **k: None
+ns["EXE"] = lambda *a, **k: None
+real_import = __import__
+def fake_import(name, *a, **k):
