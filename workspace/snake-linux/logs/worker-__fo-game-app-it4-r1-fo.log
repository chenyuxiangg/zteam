+        assert any(
+            os_mod.path.isfile(os_mod.path.join(c, "fonts", "SourceHanSansCN-Regular.otf"))
+            for c in candidates
+        ), "候选目录 fonts/ 子目录缺少内置字体"
+
+    def test_spec_pathex_includes_dependencies(self) -> None:
