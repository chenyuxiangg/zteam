+2. 剩余 3 个失败（4-02/4-14/4-15）必须是同一真实缺陷根因
+   （TypeError: invalid color argument，MTO-4-01），而非测试代码错误。
+"""
+import os
+import subprocess
+import sys
+
+WORKSPACE = "/home/zyzs/cyx/zteam/workspace/snake-linux"
+TEST_FILE = os.path.join(WORKSPACE, "it", "game-app", "iter-4", "test_it_game_app_4.py")
+
+env = os.environ.copy()
+env["SDL_VIDEODRIVER"] = "dummy"
+env["SDL_AUDIODRIVER"] = "dummy"
+env["PYTHONPATH"] = os.pathsep.join([
+    os.path.join(WORKSPACE, "code", "game-core", "iter-2"),
+    os.path.join(WORKSPACE, "code", "gui-renderer", "iter-3"),
+    os.path.join(WORKSPACE, "code", "platform-storage", "iter-2"),
+    os.path.join(WORKSPACE, "code", "game-app", "iter-4"),
+])
+
+
+def run(args):
+    r = subprocess.run(args, capture_output=True, text=True, timeout=300, env=env,
+                       cwd="/home/zyzs/cyx/zteam")
+    return r
+
+
+print("=== [1/3] 25 个已修复/通过用例（排除 3 个已知缺陷用例） ===")
+r = run([sys.executable, "-m", "pytest", TEST_FILE,
+         "-k", "not 04_02 and not 04_14 and not 04_15",
+         "-q", "--tb=line"])
+print(r.stdout[-1200:])
+if r.returncode != 0:
+    print("STDERR:", r.stderr[-2000:])
+    print("RESULT: FAIL - 修复未生效")
+    sys.exit(1)
+print("RESULT: PASS - 25 用例全绿（测试代码修复生效）")
+
+print("\n=== [2/3] 3 个已知缺陷用例：确认失败且根因一致（MTO-4-01） ===")
+r = run([sys.executable, "-m", "pytest", TEST_FILE,
+         "-k", "04_02 or 04_14 or 04_15", "-q", "--tb=no"])
+print(r.stdout[-600:])
+fails = [ln for ln in r.stdout.splitlines() if ln.startswith("FAILED")]
+print(f"失败用例数: {len(fails)}")
+assert len(fails) == 3, f"应恰好 3 个失败，实际 {len(fails)}"
+
+print("\n=== [3/3] 失败根因抽样：必须为 invalid color argument ===")
+r = run([sys.executable, "-m", "pytest", TEST_FILE,
+         "-k", "04_02", "--tb=long"])
+reason = "TypeError: invalid color argument" in r.stdout
+print(f"4-02 失败含 'TypeError: invalid color argument': {reason}")
+if not reason:
+    print(r.stdout[-1500:])
+    print("RESULT: FAIL - 根因与 MTO-4-01 不一致，需排查")
+    sys.exit(1)
+print("\nRESULT: PASS - 3 个失败均为 MTO-4-01 同一真实缺陷，非测试代码问题")
+print("总结：25 passed + 3 failed(same root cause MTO-4-01) 与报告一致")

