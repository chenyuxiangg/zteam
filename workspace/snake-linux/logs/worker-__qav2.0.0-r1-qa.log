+"""Ad-hoc verification for snake-linux v2.0.0 release package (hermes-verify).
+
+Verifies the QA release package is self-consistent and runnable:
+  1. SHA256SUMS integrity of all 4 deliverables;
+  2. tar.gz extracts cleanly and contains the four packages + spec + scripts + docs;
+  3. the extracted source runs (import + App init + game + render) under SDL dummy;
+  4. tempfile-safe (all scratch under tempfile.mkdtemp), cleaned up on exit.
+
+This is throwaway ad-hoc verification, NOT the project test suite.
+"""
+from __future__ import annotations
+
+import hashlib
+import os
+import subprocess
+import sys
+import tarfile
+import tempfile
+
+REL_DIR = "/home/zyzs/cyx/zteam/workspace/snake-linux/release/v2.0.0"
+FILES = ["发布说明.md", "用户指南.md", "可用性自检.md", "snake-linux-v2.0.0.tar.gz"]
+
+results = []
+
+
+def check(name: str, cond: bool, detail: str = "") -> None:
+    results.append((name, bool(cond), detail))
+    print(f"[{'PASS' if cond else 'FAIL'}] {name} {detail}")
+
+
+def sha256(path: str) -> str:
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(65536), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def main() -> int:
+    scratch = tempfile.mkdtemp(prefix="hermes-verify-snake-")
+    try:
+        # 1. SHA256SUMS integrity
+        sums = {}
+        with open(os.path.join(REL_DIR, "SHA256SUMS"), encoding="utf-8") as f:
+            for line in f:
+                line = line.strip()
+                if not line:
+                    continue
+                h, _, name = line.partition("  ")
+                sums[name.strip()] = h
+        ok = True
+        for name in FILES:
+            p = os.path.join(REL_DIR, name)
+            match = os.path.isfile(p) and sha256(p) == sums.get(name)
+            ok = ok and match
+        check("SHA256SUMS 全量校验", ok, f"{len(sums)} 条记录，{len(FILES)} 交付物")
+
+        # 2. tar.gz extract + structure
+        tarpath = os.path.join(REL_DIR, "snake-linux-v2.0.0.tar.gz")
+        extract = os.path.join(scratch, "extract")
+        os.makedirs(extract, exist_ok=True)
+        with tarfile.open(tarpath, "r:gz") as tf:
+            tf.extractall(extract)
+        root = os.path.join(extract, "snake-linux-v2.0.0")
+        need = ["game_core", "platform_storage", "gui_renderer", "game_app",
+                "spec", "scripts", "release", "README.md", "requirements.txt"]
+        have = [n for n in need if os.path.exists(os.path.join(root, n))]
+        check("tar.gz 结构完整", set(have) == set(need), f"缺 {set(need) - set(have)}" if set(have) != set(need) else f"{len(have)}/{len(need)} 项齐")
+
+        # 3. extracted source runs
+        env = dict(os.environ)
+        env["SDL_VIDEODRIVER"] = "dummy"
+        env["SDL_AUDIODRIVER"] = "dummy"
+        env["XDG_DATA_HOME"] = os.path.join(scratch, "xdg")
+        code = (
+            "from game_app import App, AppConfigV3\n"
+            "from game_core import Difficulty\n"
+            "a = App(AppConfigV3()); a._init_pygame(); a._new_game(Difficulty.HARD); "
