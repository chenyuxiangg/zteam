+"""Ad-hoc verification for gui-renderer iter-1 IT test suite.
+
+Runs the freshly-written test file + conftest against the module code,
+captures real pytest output, asserts pass count and zero issues, then cleans up.
+
+This is ad-hoc verification (not a CI gate) — explicit re-run of the
+actual suite the user just modified, captured to a tempfile with the
+required hermes-verify- prefix.
+"""
+import json
+import os
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+IT_DIR = Path("/home/zyzs/cyx/zteam/workspace/snake-linux/it/gui-renderer/iter-1")
+os.chdir(IT_DIR)
+
+fd, tmp_path = tempfile.mkstemp(prefix="hermes-verify-gui-renderer-it-", suffix=".log")
+os.close(fd)
+log_path = Path(tmp_path)
+
+try:
+    # 1) Collection sanity
+    collect = subprocess.run(
+        [sys.executable, "-m", "pytest", "test_it_gui_renderer_1.py",
+         "--collect-only", "-q", "--no-header"],
+        capture_output=True, text=True, timeout=60,
+    )
+    print("=== COLLECT ===")
+    print("exit:", collect.returncode)
+    print(collect.stdout[-1200:])
+    if collect.returncode != 0:
+        print("STDERR:", collect.stderr[-1500:])
+        sys.exit(1)
+
+    collected = sum(1 for line in collect.stdout.splitlines() if "::test_it_gui_renderer_1_" in line)
+    print(f">>> collected {collected} test items")
+
+    # 2) Real run
+    junit = IT_DIR / "it-report.xml"
+    if junit.exists():
+        junit.unlink()
+    run = subprocess.run(
+        [sys.executable, "-m", "pytest", "test_it_gui_renderer_1.py",
+         "-v", "--tb=short", f"--junitxml={junit}"],
+        capture_output=True, text=True, timeout=120,
+    )
+    log_path.write_text(
+        f"=== STDOUT ===\n{run.stdout}\n=== STDERR ===\n{run.stderr}\n",
+        encoding="utf-8",
+    )
+    print("=== RUN ===")
+    print("exit:", run.returncode)
+    tail = run.stdout.splitlines()[-15:]
+    print("\n".join(tail))
+    print(f">>> log written to: {log_path}")
+    print(f">>> junitxml: {junit} (exists={junit.exists()})")
+
+    assert run.returncode == 0, f"pytest exit {run.returncode} (see {log_path})"
+    assert "31 passed" in run.stdout, f"expected 31 passed in stdout; log={log_path}"
+    assert junit.exists() and junit.stat().st_size > 0, "junitxml not written"
+
+    # 3) AST check
+    import ast
+    test_src = (IT_DIR / "test_it_gui_renderer_1.py").read_text(encoding="utf-8")
+    tree = ast.parse(test_src)
+    funcs = [n.name for n in ast.walk(tree)
+             if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))
+             and n.name.startswith("test_")]
+    p0_keys = ("_1_01", "_1_02", "_1_03", "_1_04", "_1_05", "_1_06", "_1_08",
+               "_1_09", "_1_14", "_1_15", "_1_16", "_1_20", "_1_21", "_1_24",
+               "_1_25", "_1_26", "_1_29", "_1_30", "_1_31")
+    p0 = [f for f in funcs if any(k in f for k in p0_keys)]
+    p1 = [f for f in funcs if f not in p0]
+    print(f">>> test functions: {len(funcs)} (p0={len(p0)}, p1={len(p1)})")
+    assert len(funcs) == 31, f"expected 31 test functions, found {len(funcs)}"
