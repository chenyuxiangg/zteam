+import sys
+sys.path.insert(0, "/home/zyzs/cyx/zteam/workspace/gomoku/code/gomoku-r3")
+from gomoku.board import Board
+
+# Case 1: 5 stones in a row already, target = 6th stone → would create 6 in a row
+# Per plan §5.2 priority "先查成五（cnt==5 且无长连）→ 判黑胜"  → 应该是 black wins
+b = Board(15)
+for x in range(5):
+    b.place(x, 7, 'B')
+fb, reason = b.check_forbidden(5, 7, 'B')
+print(f"5-stone existing, target (5,7): got {(fb, reason)}  expected (False,None) per plan §5.2 priority")
+# Per plan, "cnt==5 且无长连" → 五胜. But "且无长连" means: if the placement also forms 6+
+# then 长连 overrides 五. So with cnt==6, this IS overline forbidden. Plan is ambiguous:
+# strict reading: "if cnt==5 AND no 长连 → 五胜" means when cnt >= 6 (i.e., 长连), check 长连 not 五.
+
+# Case 2: 5 stones in a row with a gap, target closes the gap to form exactly 5 + extra elsewhere
+# Better fixture: row has _XXXX X_ pattern. Target at gap makes 7 in a row → overline, but
+# also creates a five-in-a-row in the middle.
+b = Board(15)
+b.place(0, 7, 'B'); b.place(1, 7, 'B'); b.place(2, 7, 'B')
+b.place(3, 7, 'B'); b.place(4, 7, 'B')
+# Now (5,7) → cnt=6 → overline → forbidden
+fb, reason = b.check_forbidden(5, 7, 'B')
+print(f"5-in-row + target extends → cnt=6: got {(fb, reason)}")
+
+# Case 3: Per UTB-13 description in testplan: "构造'落子同时成五且该点亦构成禁手（如五连含双四）'"
+# This is the real intent: the placement FORMS a five-in-a-row AND ALSO triggers another forbidden
+# rule. Example: a four-direction placement where one direction has exactly 5 stones AND another
+# direction has a double-four.
+# Construct: row 7 has _XXX (3 stones), col 7 has _XXX (3 stones) at different positions
+# Target (5,7) would: in row → XXX plus stones at (6,7)(7,7) → no five. in col → also.
+# Simpler: pre-place to create a setup where new placement is exactly 5 + double four.
+
+# Case 3a: pre-place 4 stones in row + 4 stones in col → target = both makes 5
+b = Board(15)
