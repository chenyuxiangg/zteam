+"""True UTB-13 fixture: placement forms a five AND triggers another forbidden rule (e.g. double-four)."""
+import sys
+sys.path.insert(0, "/home/zyzs/cyx/zteam/workspace/gomoku/code/gomoku-r3")
+from gomoku.board import Board
+
+# Wikipedia Renju: the classical case where 五连 and 双三/双四 conflict.
+# Per plan §5.2 / testplan UTB-13: "构造'落子同时成五且该点亦构成禁手'"
+# The classical fixture: 落子同时形成 five + double-three
+# Setup: row 7 has _XXX_ (live three); col 7 has _XXX_ (live three) — disjoint so far.
+# Then place a stone at the intersection. Both lines become 4 — double-four? or does placement
+# at the crossing make one of them a five?
+
+# Classical Renju fixture for "five overrides double-three":
+# Row 7:  . . . . X X X X . . . . X (target at (8,7) makes 5-in-row)
+# Wait — let me use plan's example: "落子同时成五且该点亦构成禁手（如五连含双四）"
+# Easier fixture: the placement forms five in one direction AND a double-four (open four in two directions)
+# Row:  X X X X .  (4 stones, gap, then target at gap → forms 5)
+# Col:  X X X X .  (same)
+# So target is at the crossing where both lines have 4 + 1 gap → both become 5 after placement.
+
+# Setup:
+b = Board(15)
+b.place(0, 7, 'B'); b.place(1, 7, 'B'); b.place(2, 7, 'B'); b.place(3, 7, 'B')  # row
+b.place(7, 3, 'B'); b.place(7, 4, 'B'); b.place(7, 5, 'B'); b.place(7, 6, 'B')  # col
+# Target (7,7) → row 7 = XXXX. . . . . . . . X  (no, the stone at (7,7) is not on row 7 col 7)
+# Wait (7,7) is the cell at x=7, y=7. Row 7 has stones at x=0,1,2,3. So at row 7, after placement,
+# we have stones at 0,1,2,3 and (7,7) — they're at different x values on same row.
+# Row 7 after: X X X X . . . X . . . . . . . — that has 4 + isolated 1, not five.
+
+# Better: 4 stones in row 7 starting at x=0..3, then target at x=4 → makes 5 in row at x=0..4
+# In col 4: place stones at y=0..3, then target at y=4 makes 5 in col.
+# Both happen when we place at (4,4).
+b = Board(15)
+b.place(0, 7, 'B'); b.place(1, 7, 'B'); b.place(2, 7, 'B'); b.place(3, 7, 'B')  # row 7
+b.place(4, 0, 'B'); b.place(4, 1, 'B'); b.place(4, 2, 'B'); b.place(4, 3, 'B')  # col 4
+# Target (4,7): row 7 = XXXX X  (cnt=5), col 4 = XXXX (y=0..3) + stone at y=7 (isolated, cnt=1)
+# Hmm, need to coordinate so (4,7) is the intersection. After placement:
+# Row 7 at y=7: stones at x=0,1,2,3,4 → cnt=5 → win!
+# Col 4 at x=4: stones at y=0,1,2,3,7 → not in line.
+# So this fixture has 5 in row, no double. Let me add 4 in col 4 up to y=7.
+b = Board(15)
+b.place(0, 7, 'B'); b.place(1, 7, 'B'); b.place(2, 7, 'B'); b.place(3, 7, 'B')  # row 7: x=0..3
+b.place(4, 4, 'B'); b.place(4, 5, 'B'); b.place(4, 6, 'B')  # col 4: y=4,5,6
+# Target (4,7): row 7 → x=0..3 + (4,7) = 5 in row. col 4 → y=4,5,6 + (4,7) = 4 in col (live four, both ends open since (4,3) and (4,8) empty).
+# So target forms 5 in row AND live four in col → cnt=5 in one direction, no overline.
+# Per plan: 5-in-a-row → wins. Result expected (False, None).
+fb, reason = b.check_forbidden(4, 7, 'B')
+print(f"5 in row + live four in col: got {(fb, reason)}  expected (False, None)")
+b.place(4, 7, 'B')
+print(f"  check_win(4,7) = {b.check_win(4,7)}  expected 'B'")
+
+# Now classic: target forms 5 in row + DOUBLE-FOUR
+b = Board(15)
+b.place(0, 7, 'B'); b.place(1, 7, 'B'); b.place(2, 7, 'B'); b.place(3, 7, 'B')  # row 7
+b.place(4, 4, 'B'); b.place(4, 5, 'B'); b.place(4, 6, 'B')
+b.place(2, 4, 'B')  # row 4 at x=2
+# Target (4,7): row 7 → cnt=5 (win). col 4 → y=4,5,6 + (4,7) → 4-stone live-four.
+# Row 4 at y=4: x=2 + (4,4) → not 4. Hmm.
+# Let me build properly. Target at (4,7):
+#   - row 7: need 4 stones adjacent → (3,7)(2,7)(1,7)(0,7) ✓
+#   - col 4: need 3 stones adjacent → (4,4)(4,5)(4,6) ✓
+#   - diag (dx=1, dy=-1) through (4,7): need 3 adjacent → (3,6)(2,5)(1,4)
+# Place (3,6) and (2,5) and (1,4) → 3 stones diagonally → with target makes 4 → live four
+# But (3,6) conflicts with (4,5)? No: (3,6) and (4,5) are different cells.
+b = Board(15)
+b.place(0, 7, 'B'); b.place(1, 7, 'B'); b.place(2, 7, 'B'); b.place(3, 7, 'B')
+b.place(4, 4, 'B'); b.place(4, 5, 'B'); b.place(4, 6, 'B')
+b.place(3, 6, 'B'); b.place(2, 5, 'B'); b.place(1, 4, 'B')
+# Target (4,7): row 7 → cnt=5 (win); col 4 → cnt=4 (live four); diag (1,-1) → cnt=4 (live four, _XXXX_)
+# → this placement creates 5 in row + double-four → per plan §5.2 should return (False, None) because 5 wins
+fb, reason = b.check_forbidden(4, 7, 'B')
+print(f"5 in row + double-four (in 2 other dirs): got {(fb, reason)}  expected (False, None)")
+b.place(4, 7, 'B')
+print(f"  check_win(4,7) = {b.check_win(4,7)}  expected 'B'")

