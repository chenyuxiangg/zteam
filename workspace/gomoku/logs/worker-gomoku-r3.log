+"""
+r3 修复验证：完整覆盖所有标准 Renju 活三形态 + 评审复现 case + 边界 case
+
+参考：plan §5.2 / FR-07 / UTB-10~16 / r2 review §2 意见 1&2
+"""
+from gomoku.board import Board
+
+
+def check(name, board, target, expected, color="B"):
+    """target=(x,y); 调用 _is_live_three 验证 (x,y) 视角下某方向是否活三"""
+    tx, ty = target
+    ok = True
+    for d in [(1,0), (0,1), (1,1), (1,-1)]:
+        res = board._is_live_three(tx, ty, d[0], d[1])
+        if res != expected:
+            print(f"FAIL {name}: _is_live_three({tx},{ty},{d}) = {res}, expected {expected}")
+            ok = False
+    return ok
+
+
+# === 1. 评审复现 case：review-case-A 跳活三最左 X ==================
+print("=== review-case-A 跳活三最左 X 漏判（r2 报告的 P0）===")
+b = Board(15)
+b.place(5, 7, 'B'); b.place(7, 7, 'B'); b.place(8, 7, 'B')
+b.place(5, 5, 'B'); b.place(5, 6, 'B')
+
+# (5,7) line = . B . B B . (水平 _X_XX_ 跳活三) — r2 返回 False, r3 期望 True (水平方向)
+res = b._is_live_three(5, 7, 1, 0)
+print(f"  _is_live_three(5,7,1,0) (跳活三 _X_XX_ 最左 X): {res}, expected True")
+assert res == True, "FAIL: (5,7) 最左 X 漏判未修复"
+
+# (7,7) 中间 X
+res = b._is_live_three(7, 7, 1, 0)
+print(f"  _is_live_three(7,7,1,0) (跳活三 _X_XX_ 中间 X): {res}, expected True")
+assert res == True
+
+# (8,7) 最右 X
+res = b._is_live_three(8, 7, 1, 0)
+print(f"  _is_live_three(8,7,1,0) (跳活三 _X_XX_ 最右 X): {res}, expected True")
+assert res == True
+
+# === 2. 评审复现 case：review-case-B 跳活三最右 X ==================
+print("\n=== review-case-B 跳活三最右 X 漏判（r2 报告的 P0）===")
+b2 = Board(15)
+b2.place(5, 7, 'B'); b2.place(6, 7, 'B'); b2.place(8, 7, 'B')  # _XX_X_ 跳活三
+b2.place(8, 6, 'B'); b2.place(8, 8, 'B')                      # 垂直 _X_X_
+
+# (5,7) line = B B . B . (水平 _XX_X_ 跳活三) — r2: True (r2 已正确), r3: True
+res = b2._is_live_three(5, 7, 1, 0)
+print(f"  _is_live_three(5,7,1,0) (跳活三 _XX_X_ 最左 X): {res}, expected True")
+assert res == True
+
