+print("  Expected: False (it's a 5/6/overline)")
+
+# Case: stone at left end of an extending _XXXX_ (4-stone run)
+# (3,7)B (4,7)B (5,7)B (6,7)B → 4 stones, checking at (3,7):
+#   Forward: (4,7)B run=1, (5,7)B run=2, (6,7)B run=3, (7,7)='.' → no ext fwd_open=True
+#   Backward: (2,7)='.' → no ext bwd_open=True
+#   Total = 1+3+0 = 4. Returns False (live four handled by _count_open_fours). OK.
+b2 = Board(15)
