+# What if we check from the middle X?
+# _X_XX_ stones at (7,7), (9,7), (10,7). Middle is ambiguous — let's check (9,7).
+b = Board(15)
+b.place(7, 7, 'B'); b.place(9, 7, 'B'); b.place(10, 7, 'B')
+print(f"_is_live_three(9,7,1,0) = {b._is_live_three(9, 7, 1, 0)}")
