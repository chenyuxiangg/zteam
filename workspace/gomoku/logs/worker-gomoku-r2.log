+"""原型：扩展型活三检测算法验证"""
+from typing import Tuple
+
+# 模拟 Board
+class MockBoard:
+    def __init__(self, size, grid):
+        self._size = size
+        self._grid = grid
+    @property
+    def size(self): return self._size
+    def get(self, x, y): return self._grid[y][x]
+    def in_bounds(self, x, y): return 0 <= x < self._size and 0 <= y < self._size
+
+_DIRECTIONS = ((1,0),(0,1),(1,1),(1,-1))
+
+
+def _extended_run_three(board, x, y, dx, dy):
+    """从 (x,y) 出发沿 (dx,dy) 方向，计算总 stone 数（含越过单空延伸）与两端开放性。
+
+    Returns:
+        total: int = 1 (落子点) + forward_run + backward_run + forward_ext + backward_ext
+        fwd_open: bool  (forward 方向延伸链最末端之后是空)
+        bwd_open: bool  (backward 方向延伸链最末端之后是空)
+
+    说明：
+    - forward_run: 从 (x+dx, y+dy) 沿 dx,dy 连续同色 stone 数
+    - forward_ext: forward_run 结束后的格子若是空，再越过一格若也是同色 stone，则算延伸 1
+    - fwd_open: forward_ext == 0 且 forward_run 结束处是空 → True
+                forward_ext == 1 且 forward_run+1+dx 处（延伸 stone 之后）是空 → True
+                边界或对方子 → False
+    """
+    n = board._size
+    color = board.get(x, y)
+
+    # Forward
+    forward_run = 0
+    nx, ny = x + dx, y + dy
+    while board.in_bounds(nx, ny) and board.get(nx, ny) == color:
+        forward_run += 1
+        nx, ny = nx + dx, ny + dy
+    # nx, ny 现在在 forward_run 之后的格子（可能是空/对方/边界）
+    forward_ext = 0
+    if board.in_bounds(nx, ny) and board.get(nx, ny) == ".":
+        # 越过这个空位，检查是否还有同色延伸
+        nx2, ny2 = nx + dx, ny + dy
+        if board.in_bounds(nx2, ny2) and board.get(nx2, ny2) == color:
+            forward_ext = 1
+            nx, ny = nx2, ny2  # 延伸 stone 的位置
+    # fwd_open：延伸链最末端之后的格子是空
+    fwd_open = False
+    if forward_ext == 1:
+        nx2, ny2 = nx + dx, ny + dy
+        fwd_open = board.in_bounds(nx2, ny2) and board.get(nx2, ny2) == "."
+    elif forward_ext == 0:
+        fwd_open = board.in_bounds(nx, ny) and board.get(nx, ny) == "."
+
+    # Backward（用 -dx, -dy 重做）
+    backward_run = 0
+    nx, ny = x - dx, y - dy
+    while board.in_bounds(nx, ny) and board.get(nx, ny) == color:
+        backward_run += 1
+        nx, ny = nx - dx, ny - dy
+    backward_ext = 0
+    if board.in_bounds(nx, ny) and board.get(nx, ny) == ".":
+        nx2, ny2 = nx - dx, ny - dy
+        if board.in_bounds(nx2, ny2) and board.get(nx2, ny2) == color:
+            backward_ext = 1
+            nx, ny = nx2, ny2
+    bwd_open = False
+    if backward_ext == 1:
+        nx2, ny2 = nx - dx, ny - dy
+        bwd_open = board.in_bounds(nx2, ny2) and board.get(nx2, ny2) == "."
+    elif backward_ext == 0:
+        bwd_open = board.in_bounds(nx, ny) and board.get(nx, ny) == "."
+
+    total = 1 + forward_run + backward_run + forward_ext + backward_ext
+    return total, fwd_open, bwd_open
+
