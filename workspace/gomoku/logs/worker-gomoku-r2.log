+# Forward from (7,7): (8,7)='.' (empty), (9,7)='B', (10,7)='B', (11,7)='.'
+#   So nx=8 → not color. forward_run=0. nx=8 is '.', check ext: nx2=9 is B → forward_ext=1, nx=9
+#   fwd_open check: nx2=10 is B → not '.'. So fwd_open=False.
+# Backward from (7,7): (6,7)='.' → not color. backward_run=0. nx=6 is '.', check ext: nx2=5 is '.' → no ext. bwd_open=True (since nx=6 is '.')
+# Total = 1 + 0 + 0 + 1 + 0 = 2. Not 3. So returns False.
+print(f"_is_live_three(7,7,1,0) = {b._is_live_three(7, 7, 1, 0)}")
+print(f"Expected True (since (7,7) is part of _X_XX_)")
