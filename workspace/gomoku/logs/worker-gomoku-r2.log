+print(f"_is_live_three(10,7,1,0) = {b._is_live_three(10, 7, 1, 0)}")
+# Forward: (11,7)='.' → no run. nx=11 is '.' nx2=12 is '.' → no ext. fwd_open=True
+# Backward: (9,7)='B' run=1, (8,7)='.' → no more run. nx=8 is '.' nx2=7 is B → backward_ext=1 nx=7
+#   bwd_open check: nx2=6 is '.' → True
+# Total = 1 + 0 + 1 + 0 + 1 = 3 ✓ → True
+
+# So _X_XX_ at left end (7,7) returns False because forward_ext=1 jumps to (9,7) but then
+# fwd_open checks (10,7) which is B, not open. The algorithm's "extension" goes through (9,7)
