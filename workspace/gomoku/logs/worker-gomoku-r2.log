+#   backward_ext = 0
+#   if 0 <= nx < n and grid[ny][nx] == '.': True (8,7 is '.')
+#     nx2, ny2 = nx - dx, ny - dy = (7, 7). grid[ny2][nx2] == color 'B'? Yes!
+#     backward_ext = 1, nx,ny = (7,7)
+#   if backward_ext == 1:
+#     nx2, ny2 = nx - dx, ny - dy = (6, 7). grid[ny2][nx2] == '.'? Yes.
+#     bwd_open = True
+# Total = 1 + 1 + 0 + 0 + 1 = 3. fwd_open=True, bwd_open=True → True! ✓
+
