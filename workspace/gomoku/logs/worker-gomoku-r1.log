+def empty_15():
+    """Empty 15x15 board (UTB-01)."""
+    from gomoku.board import Board
+    return Board(15)
+
+
+@pytest.fixture
+def empty_13():
+    """Empty 13x13 board (UTB-02)."""
+    from gomoku.board import Board
+    return Board(13)
+
+
+def place_grid(board, points):
+    """Place a list of ((x, y), color) tuples on the board in order.
+
+    Returns the board for chaining.  This is the canonical way to
+    build a fixture position without depending on place()/undo()
+    ordering details.
+    """
+    for (x, y), color in points:
+        ok = board.place(x, y, color)
+        if not ok:
+            raise AssertionError(f"failed to place {color} at {(x, y)}")
+    return board
+
+
+@pytest.fixture
+def make_board():
+    """Factory fixture: ``make_board(points)`` returns a Board with the
+    given stones placed.
+    """
+    return place_grid
