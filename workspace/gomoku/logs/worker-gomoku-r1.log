+"""AI 自检脚本（不进交付物）。"""
+import sys
+import time
+sys.path.insert(0, ".")
+
+from gomoku.board import Board
+from gomoku.ai import choose_move, candidates, evaluate_point
+
+
+def make_threat_setup():
+    """构造"白方有活三"局面（白方 (4,7),(5,7),(6,7) 三个 W 形活三）。"""
+    b = Board(15)
+    b.place(4, 7, "W")
+    b.place(5, 7, "W")
+    b.place(6, 7, "W")
+    # 黑方已经走几子（无关）
+    return b
+
+
+def test_candidates_empty():
+    print("=== 空盘候选 ===")
+    b = Board(15)
+    c = candidates(b, radius=2, limit=20)
+    assert len(c) == 1, f"空盘应只返回中心，got {c}"
+    assert c[0] == (7, 7), f"空盘中心应 (7,7)，got {c[0]}"
+    print("空盘 OK")
+
+
+def test_weak_random():
+    print("=== 弱档合法性 ===")
+    b = Board(15)
+    b.place(7, 7, "B")
+    b.place(8, 8, "W")
+    move = choose_move(b, "B", "weak")
+    assert move is not None
+    assert b.in_bounds(*move)
+    assert b.get(*move) == "."
+    print(f"弱档 {move} OK")
+
+
+def test_medium_threat_block():
+    print("=== 中档封堵（白方活三）===")
+    b = make_threat_setup()
+    # 摆几个黑子以触发邻域
+    b.place(7, 8, "B")
+    move = choose_move(b, "B", "medium", time_budget=1.0)
+    assert move is not None
+    # 应当封堵 (3,7) 或 (7,7)
+    assert move in [(3, 7), (7, 7)], f"应封堵 (3,7) 或 (7,7)，got {move}"
+    print(f"中档封堵 {move} OK")
+
+
+def test_strong_perf():
+    print("=== 强档中盘耗时 ===")
+    b = Board(15)
+    # 摆 22 个黑子 + 22 个白子交错
+    for i in range(22):
+        b.place(2 + (i % 13), 2 + (i // 2), "B" if i % 2 == 0 else "W")
+    t0 = time.monotonic()
+    move = choose_move(b, "B", "strong", time_budget=2.0)
+    dt = time.monotonic() - t0
+    assert move is not None
+    assert dt < 3.0, f"强档 {dt:.2f}s 超时"
+    print(f"强档 {move} {dt:.2f}s OK")
+
+
+def test_forbidden_avoid():
+    print("=== 强档禁手规避 ===")
+    b = Board(15)
+    # 黑已有 (3,7)(4,7)(6,7)(7,7) — 落 (5,7) 形成横 4 子，next 落 (5,7) → 再落 (2,7) 等可能触发禁手
+    for x in (3, 4, 6, 7):
+        b.place(x, 7, "B")
+    # 现在让 AI 执黑禁手开启
+    b.place(5, 7, "B")  # 已成横 5
+    # 模拟 AI 选下一步——此时黑已胜 5 连；但 verify 禁手点不出现
+    b2 = Board(15)
+    for x in (3, 4, 6, 7):
+        b2.place(x, 7, "B")
