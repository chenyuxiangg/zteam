+# =============================================================================
+class TestWeakTier:
+    """UTA-01 / UTA-02: weak tier produces legal moves and avoids
+    obvious self-loss.
+    """
+
+    def test_utb_01_weak_legality(self):
+        """UTA-01: weak AI always returns an in-bounds empty cell over
+        many random positions (FR-06 weak tier baseline).
+        """
+        rng = random.Random(42)
+        for trial in range(20):
+            b = Board(15)
