+"""test_ai.py — AI decision tests (testplan UTA-01..11).
+
+Covers the three difficulty tiers (weak / medium / strong), the
+mandatory threat-blocking behaviour (UTA-03/04/05), forbidden-move
+avoidance for AI-black (UTA-06), and the downgrade chain
+(candidates 20 → 15, depth 4 → 3) under a tight time budget
+(UTA-11).  Time-budget compliance for the strong tier on a
+mid-game position is exercised by UTA-08.
+"""
+from __future__ import annotations
+
+import random
+import time
+from typing import Tuple
+
+import pytest
+
+from gomoku.board import Board
+from gomoku.ai import choose_move, candidates, evaluate, _classify_empty
+
+
+# =============================================================================
+# Helpers — threat positions from testplan §3 baseline patterns A / B.
+# =============================================================================
+def _build_rush_four_threat(b: Board) -> Board:
+    """Layout A from testplan UTA-03: white has an open-three at row 5,
+    columns 3..5; can extend to a rush-four at (2,5) or (6,5).  AI
+    (black) MUST block one of those cells (or form a five).
+    """
+    for (x, y) in [(3, 5), (4, 5), (5, 5)]:
+        b.place(x, y, "W")
+    return b
+
+
+def _build_live_three_threat(b: Board) -> Board:
+    """Layout B from testplan UTA-04: white has a live-three at row 3,
+    columns 2..4 (``_WWW_``).  AI MUST block (1,3) or (5,3) (or form
+    a larger threat).
+    """
+    for (x, y) in [(2, 3), (3, 3), (4, 3)]:
+        b.place(x, y, "W")
+    return b
+
+
+def _is_block_cell(mv: Tuple[int, int], expected: Tuple[Tuple[int, int], ...]) -> bool:
+    """True if ``mv`` matches any of the candidate blocking cells.
+
+    The AI may also satisfy the test by forming a five of its own —
+    that case passes too, but the typical small-mid-board threat
+    positions seldom allow it.
+    """
+    return mv in expected
+
+
+def _is_five_for_self(b: Board, mv: Tuple[int, int], color: str) -> bool:
+    """Did the AI just complete a 5-in-a-row for itself?"""
+    b.place(mv[0], mv[1], color)
+    try:
+        return b.check_win(mv[0], mv[1]) == color
+    finally:
+        b.undo(mv[0], mv[1])
+
+
