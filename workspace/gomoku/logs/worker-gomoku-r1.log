+sys.path.insert(0, os.path.dirname(__file__))
+
+from gomoku.board import Board, MoveError
+from gomoku.forbidden_cases import ALL_CASES
+
+
+def render_local(board_grid, cx, cy):
+    """打印局部棋盘（中心点用 [B] 标记）。"""
+    out = []
+    rows = len(board_grid)
+    cols = len(board_grid[0])
+    for y in range(rows):
+        line = []
+        for x in range(cols):
+            if x == cx and y == cy:
+                line.append("[B]")
+            else:
+                line.append(" " + board_grid[y][x] + " ")
+        out.append("".join(line))
+    return "\n".join(out)
+
+
+def local_to_full(grid, cx, cy, board_size=15):
+    """把局部 pattern 居中、其余补 '.' 放入 15×15 棋盘。"""
+    b = Board(board_size)
+    rows = len(grid)
+    cols = len(grid[0])
+    ox = (board_size - cols) // 2
+    oy = (board_size - rows) // 2
+    for y in range(rows):
+        for x in range(cols):
+            v = grid[y][x]
+            if v == "B":
+                b.place(ox + x, oy + y, "B")
+    # 落子点
+    full_x = ox + cx
+    full_y = oy + cy
+    b.place(full_x, full_y, "B")
+    return b, full_x, full_y
+
+
+def run_cases():
+    total = 0
+    fail = 0
+    for case in ALL_CASES:
+        total += 1
+        b, fx, fy = local_to_full(case.pattern, case.center[0], case.center[1])
+        got = b.check_forbidden(fx, fy, "B")
+        ok = (got[0] == case.expected_forbidden) and (got[1] == case.expected_reason)
+        marker = "OK" if ok else "FAIL"
+        print(f"[{marker}] {case.name}: expected=({case.expected_forbidden},{case.expected_reason}) got={got}")
+        if not ok:
+            fail += 1
+            print(render_local(case.pattern, case.center[0], case.center[1]))
+            print("---")
+    print(f"\n总计 {total} 用例，失败 {fail}")
+    return fail
+
+
+def run_basic():
+    print("=== 基础胜负 ===")
