+    for x in range(4):
+        b.place(x, 7, "B")
+    winner = b.check_win(4, 7)
+    assert winner == "B", f"横五应胜，得到 {winner}"
+    print("横五 OK")
+
+    b = Board(15)
+    for y in range(4):
+        b.place(7, y, "W")
+    winner = b.place(7, 4, "W") and b.check_win(7, 4)
