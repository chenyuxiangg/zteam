+"""test_integration.py — integration tests (testplan IT-01..04).
+
+These tests exercise Board × AI in tandem, verifying:
+
+* Turn alternation and color correctness (IT-01).
+* Win detection on each of the 4 directions (IT-02).
+* Forbidden-move game-end flow (IT-03).
+* Draw on a full board with no five (IT-04).
+
+The tests use Board and AI directly (no UI) — the integration point
+is the choice-evaluation loop: choose_move → place → check_win /
+is_full → swap.
+"""
+from __future__ import annotations
+
+import random
+
+import pytest
+
+from gomoku.ai import choose_move
+from gomoku.board import Board
+
+
+# =============================================================================
+# Helpers
+# =============================================================================
+def _play_n_moves(b: Board, n: int, ai_color: str, difficulty: str = "weak",
+                   rng_seed: int = 0):
+    """Drive ``n`` total moves, alternating B / W starting with B."""
+    rng = random.Random(rng_seed)
+    cur = "B"
+    moves = []
+    for _ in range(n):
+        if b.is_full():
+            break
+        if cur == ai_color:
+            mv = choose_move(b, cur, difficulty, rng=rng)
+        else:
+            # Use a fixed position-seeded pseudo-random move for "human"
+            # so the test is deterministic.  We pick the first empty
+            # cell whose hash matches the move counter.
+            empties = [
+                (x, y)
+                for y in range(b.size)
+                for x in range(b.size)
+                if b.get(x, y) == "."
+            ]
+            if not empties:
+                break
+            mv = empties[(rng.randrange(len(empties)) + len(moves)) % len(empties)]
+        if mv is None:
+            break
+        assert b.place(mv[0], mv[1], cur)
+        moves.append((mv, cur))
+        cur = "W" if cur == "B" else "B"
+    return moves
+
+
+# =============================================================================
+# IT-01 — turn alternation
+# =============================================================================
+class TestTurnAlternation:
+    def test_it_01_alternating_turns(self):
+        """IT-01: across 20 total moves, turns alternate B / W / B / …
+        with no consecutive same-color moves.
+        """
+        b = Board(15)
+        # Pre-populate a couple of centre stones so AI has a place to go.
+        b.place(7, 7, "B")
+        moves = _play_n_moves(b, 20, ai_color="W", difficulty="weak", rng_seed=11)
+        # Check alternation strictly.
+        prev = None
+        for (mv, color) in moves:
+            assert color != prev, (
+                f"turn did not alternate: two consecutive {color} moves"
+            )
+            prev = color
+        # Total alternation count: |B_count - W_count| ≤ 1
