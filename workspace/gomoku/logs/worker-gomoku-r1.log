+"""test_e2e.py — pexpect-driven end-to-end tests (testplan ST-01..16).
+
+These tests drive the real ``gomoku`` process through a pty and
+verify the rendered output.  Coverage:
+
+* Startup timing and default rendering (ST-01, ST-04, ST-05).
+* Turn alternation and last-move display (ST-07, ST-09, ST-10).
+* Input validation and the error-reprompt loop (ST-06).
+* Forbidden-move handling end-to-end (ST-02, ST-03).
+* AI blocking in a real game (ST-08 — sampled).
+* Win detection and game-end rendering (ST-11).
+* Restart / play-again flow (ST-12, ST-13).
+* Ctrl+C cleanup (ST-14, ST-15, ST-16).
+* Configuration CLI behaviour (ST-24, ST-25).
+
+Most cases share a single ``gomoku_proc`` fixture that spawns the
+process.  The fixture uses ``size=15``, ``difficulty=medium`` and
+``human=black`` by default; individual tests can override args.
+
+These tests are marked ``@pytest.mark.e2e`` so a CI can run them
+separately (or skip them on resources-constrained agents).
+"""
+from __future__ import annotations
+
+import os
+import re
+import sys
+import time
+from pathlib import Path
+
+import pytest
+
+try:
+    import pexpect
+    HAS_PEXPECT = True
+except ImportError:  # pragma: no cover
+    HAS_PEXPECT = False
+
+
+# All tests require pexpect AND a working terminal — skip gracefully if
+# not available.
+pexpect_required = pytest.mark.skipif(
+    not HAS_PEXPECT,
+    reason="pexpect not installed; install via `pip install pexpect`",
+)
+
+# Marker so they can be selected / deselected as a group.
+pytestmark_e2e = pytest.mark.e2e
+
+
+# ----------------------------------------------------------------------------
+# Helper: spawn the gomoku CLI in a pty.
+# ----------------------------------------------------------------------------
+GOMOKU_BIN = sys.executable  # reuse the python that has gomoku installed.
+
+
+def _spawn(args, cols=80, rows=24, env_extra=None):
+    """Spawn ``python -m gomoku [args]`` in a new pty."""
+    cmd = [GOMOKU_BIN, "-m", "gomoku"] + list(args)
+    env = os.environ.copy()
+    env["COLUMNS"] = str(cols)
+    env["LINES"] = str(rows)
+    env["NO_COLOR"] = "1"  # consistent output across hosts
+    env["TERM"] = "dumb"
+    if env_extra:
+        env.update(env_extra)
+    return pexpect.spawn(
+        cmd[0], cmd[1:],
+        dimensions=(rows, cols),
+        encoding="utf-8",
+        timeout=10,
+        env=env,
+    )
+
+
+def _wait_for_prompt(proc, timeout=5):
+    """Block until the ``请输入落子坐标`` prompt appears."""
+    proc.expect(re.compile(r"请输入落子坐标"), timeout=timeout)
