+"""test_board.py — board rule tests (testplan UTB-01..29).
+
+These tests cover Board construction, coordinate parsing (parse_move),
+move legality (place / undo), win detection (check_win / is_full),
+forbidden-move classification (check_forbidden including all
+Renju shapes), and the snapshot/undo API contract.
+
+All cases are derived from workspace/gomoku/testplans/gomoku-r1.md §3
+"单元测试用例表（board：UTB 系列）".
+"""
+from __future__ import annotations
+
+import pytest
+
+from gomoku.board import Board, MoveError, parse_move
+
+
+# =============================================================================
+# UTB-01..03 — Board construction (FR-01)
+# =============================================================================
+class TestBoardConstruction:
+    """UTB-01 / UTB-02 / UTB-03 — construction & size validation."""
+
+    def test_utb_01_default_15(self):
+        """UTB-01: Board(15) yields a 15x15 empty grid (FR-01)."""
+        b = Board(15)
+        assert b.size == 15
+        assert b.move_count() == 0
+        assert all(b.get(x, y) == "." for x in range(15) for y in range(15))
+
+    def test_utb_02_alternate_13(self):
+        """UTB-02: Board(13) yields a 13x13 empty grid (FR-01, alt size)."""
+        b = Board(13)
