+"""forbidden_cases.py — 禁手判定对照表（≥10 例棋形 → 预期结论）。
+
+与方案 §5.2 / §7 T3 / testplan U-20 对应。
+约定：本模块是禁手判定的"事实源"——评审与测试可通过对比本表与
+    Board.check_forbidden 的实际结果验证实现正确性。
+
+运行自检：`python -m gomoku.forbidden_cases`。
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from .board import Board
+
+
+@dataclass(frozen=True)
+class ForbiddenCase:
+    """单个禁手判定用例。"""
+
+    name: str           # 形态名（说明用）
+    pattern: tuple[str, ...]   # 棋形行（每行一个字符串，'B'/'W'/'.'）
+    center: tuple[int, int]    # 检查 (x, y)（pattern 局部坐标）
+    expected_forbidden: bool   # 预期是否禁手
+    expected_reason: str | None  # 预期 reason
+    description: str = ""      # 形态补充说明
+
+
+def _case(
+    name: str,
+    rows: list[str],
+    center: tuple[int, int],
+    expected_forbidden: bool,
+    expected_reason: str | None,
+    description: str = "",
+) -> ForbiddenCase:
+    return ForbiddenCase(
+        name=name,
+        pattern=tuple(rows),
+        center=center,
+        expected_forbidden=expected_forbidden,
+        expected_reason=expected_reason,
+        description=description,
+    )
+
+
+# ---- 对照表（≥10 例 + 一些 NOT-FORBIDDEN 用例）----
+
+
+def _build_table() -> list[ForbiddenCase]:
+    """构造禁手判定对照表。"""
+    return [
