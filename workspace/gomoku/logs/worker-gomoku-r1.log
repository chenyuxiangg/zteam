+"""Ad-hoc verification for gomoku-r1 code-stage deliverable.
+
+Covers:
+  * byte-compile of all package modules
+  * CLI smoke (--help, --version, invalid args)
+  * Board: place/undo/parse_move/check_win/check_forbidden/is_full
+  * AI: weak/medium/strong tiers + downgrade chain under tight budget
+  * Module imports
+  * Forbidden-move verdict on the cases that the previous r1 FAILED on
+
+This is *ad-hoc verification* (not the test-developer's suite).  The
+goal is to confirm the rebuilt code at least passes the scenarios
+that the code reviewer flagged FAIL on the previous cycle.
+"""
+from __future__ import annotations
+
+import os
+import py_compile
+import random
+import subprocess
+import sys
+import tempfile
+import time
+import traceback
+
+PKG_ROOT = "/home/zyzs/cyx/zteam/workspace/gomoku/code/gomoku-r1"
+PKG_DIR = os.path.join(PKG_ROOT, "gomoku")
+
+failures = []
+def check(label, ok, detail=""):
+    if ok:
+        print(f"  PASS  {label}")
+    else:
+        print(f"  FAIL  {label}  {detail}")
+        failures.append((label, detail))
+
+
+# --- 1. Compile every module ---
+print("[1] byte-compile")
+for fname in sorted(os.listdir(PKG_DIR)):
+    if fname.endswith(".py"):
+        path = os.path.join(PKG_DIR, fname)
+        try:
+            py_compile.compile(path, doraise=True)
+            check(f"py_compile {fname}", True)
+        except py_compile.PyCompileError as e:
+            check(f"py_compile {fname}", False, str(e))
+
+# --- 2. CLI smoke ---
+print("[2] CLI smoke")
+sys.path.insert(0, PKG_ROOT)
+
+def run_cli(*args, timeout=10):
+    return subprocess.run(
+        [sys.executable, "-m", "gomoku", *args],
+        capture_output=True, text=True, timeout=timeout,
+        cwd=PKG_ROOT,
+    )
+
+r = run_cli("--help")
+check("gomoku --help exit 0", r.returncode == 0)
+check("--help mentions --size", "--size" in r.stdout)
+check("--help mentions --difficulty", "--difficulty" in r.stdout)
+
+r = run_cli("--version")
+check("gomoku --version exit 0", r.returncode == 0)
+check("--version prints 0.2.0", "0.2.0" in r.stdout)
+
+r = run_cli("--size", "12")  # invalid
+check("--size 12 rejected (argparse exit 2)", r.returncode == 2)
+check("--size 12 error mentions size", "size" in (r.stderr + r.stdout).lower())
+
+# --- 3. Imports ---
+print("[3] Imports")
+try:
+    import gomoku
+    import gomoku.board
+    import gomoku.ai
