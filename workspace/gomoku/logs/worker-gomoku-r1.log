+    message: str = ""           # 状态栏附加消息（如禁手警告）
+    over: bool = False
+    winner: Optional[str] = None  # 'B' / 'W' / None（平局）
+    forbidden_reason: Optional[str] = None  # 禁手原因（人类落子非法时显示）
+
+
+_B_CHAR = "●"   # 黑
+_W_CHAR = "○"   # 白
+_DOT_CHAR = "·"
+
+
+class UI:
