+#!/bin/bash
+# Ad-hoc verification of gomoku test-developer r1 output.
+# NOT a substitute for the full pytest suite — see README.md for canonical run command.
+
+set -e
+ROOT=/home/zyzs/cyx/zteam
+TESTDIR=$ROOT/workspace/gomoku/tests/gomoku-r1
+CODEDIR=$ROOT/workspace/gomoku/code/gomoku-r3
+export PYTHONPATH=$CODEDIR
+
+echo "=== 1. 产物结构完整性 ==="
+test -f "$TESTDIR/README.md" && echo "OK README.md"
+test -f "$TESTDIR/tests/conftest.py" && echo "OK conftest.py"
+test -f "$TESTDIR/tests/test_board.py" && echo "OK test_board.py"
+test -f "$TESTDIR/tests/test_ai.py" && echo "OK test_ai.py"
+test -f "$TESTDIR/tests/test_integration.py" && echo "OK test_integration.py"
+test -f "$TESTDIR/tests/test_e2e.py" && echo "OK test_e2e.py"
+test -x "$TESTDIR/scripts/bench_ai.py" && echo "OK bench_ai.py"
+test -x "$TESTDIR/scripts/fuzz_input.py" && echo "OK fuzz_input.py"
+
+echo
+echo "=== 2. pytest 收集能否找到所有用例 ==="
+cd "$TESTDIR" && python3 -m pytest tests/ --collect-only -q 2>&1 | tail -5
+
+echo
+echo "=== 3. L1+L2（unit + integration，不含 e2e）==="
+cd "$TESTDIR" && python3 -m pytest tests/test_board.py tests/test_ai.py tests/test_integration.py -q --no-header 2>&1 | tail -3
+
+echo
+echo "=== 4. L3 E2E ==="
+cd "$TESTDIR" && python3 -m pytest tests/test_e2e.py -q --no-header 2>&1 | tail -3
+
+echo
+echo "=== 5. bench_ai 性能脚本（5 局）==="
+cd "$TESTDIR" && python3 scripts/bench_ai.py --games 5 2>&1 | tail -8
+
+echo
+echo "=== 6. fuzz_input（30 轮，缩短以保验证快速）==="
+cd "$TESTDIR" && python3 scripts/fuzz_input.py --rounds 30 --seed 42 2>&1 | tail -5
+
+echo
+echo "=== 7. 状态机：set_status reviewing 是否已落 ==="
+cd "$ROOT" && python3 scripts/statectl.py get gomoku/gomoku | python3 -c "import sys, json; d=json.load(sys.stdin); print('status:', d['status']); print('test stage state:', d['stages']['test']['state']); print('product:', d['stages']['test']['product'])"

