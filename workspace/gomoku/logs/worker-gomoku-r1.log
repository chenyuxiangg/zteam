@@ -0,0 +1,408 @@
+"""Forbidden-move decision table (plan T3 / §5.2, testplan UTB-17).
+
+This module is the *single source of truth* for the canonical
+Renju-flavoured forbidden-move shapes that the gomoku engine must
+classify.  Each row pairs a board-position description with the
+expected verdict of ``Board.check_forbidden(x, y, "B")`` immediately
+after placing a black stone at the indicated coordinate.
+
+The table is intentionally hand-curated, not generated: it is meant to
+be:
+
+* **auditable** — every row is a comment; the reader can re-derive the
+  expected verdict without running any code;
+* **parameterised** — ``pytest`` can iterate over the entries (see
+  ``tests/test_board.py::test_check_forbidden_parameterised``) without
+  duplicating fixtures;
+* **stable** — row IDs (``FORBIDDEN_TABLE_IDS``) are used by the
+  board rules (board.py) and the AI (ai.py) as cross-references when
+  logs and code comments disagree.
+
+Row schema
+----------
+Each entry is a 5-tuple:
+
+    (id, description, setup, probe, expected)
+
+where:
+
+* ``id``         — short uppercase snake_case identifier, unique.
+* ``description``— human-readable prose describing the pattern (Chinese
+                   OK; this file is consumed only by humans).
+* ``setup``      — a callable ``(Board) -> None`` that places the
+                   pre-move stones that create the shape.
+* ``probe``      — the ``(x, y)`` tuple at which to evaluate
+                   ``check_forbidden``.
+* ``expected``   — the expected tuple returned by ``check_forbidden``,
+                   either ``(True, "<reason>")`` or ``(False, None)``.
+
+Reasons (matching ``Board.check_forbidden`` output):
+    ``"overline"``       — six or more in a row.
+    ``"double_four"``    — at least two fours (live or rush) are formed.
+    ``"double_three"``   — at least two live threes are formed.
+    ``None``             — move is legal (or it wins, which we present
+                           separately in ``WIN_OVERRIDE_TABLE``).
+
+We provide **at least 10 rows** in the basic table (plan T3 requires
+``≥ 10 cases``) plus a separate *win-overrides-forbidden* sub-table
+that the testplan UTB-13 specifically exercises.
+"""
+from __future__ import annotations
+
+from typing import Callable, List, Optional, Tuple
+
+from .board import Board
+
+
+# Type alias
+Case = Tuple[
+    str,                                            # id
+    str,                                            # description
+    Callable[[Board], None],                        # setup
+    Tuple[int, int],                                # probe (x, y)
+    Tuple[bool, Optional[str]],                     # expected (is_forbidden, reason)
+]
+
+
+# ---------------------------------------------------------------------------
+# Setup helpers — short callable objects that place the pre-move stones.
+# Using callables (not plain lists) keeps each row compact while still
+# being locally readable: every row literally says "place X at (a, b)".
+# ---------------------------------------------------------------------------
+def setup_moves(board: Board, moves: List[Tuple[int, int, str]]) -> None:
+    for x, y, c in moves:
+        if not board.place(x, y, c):
+            raise ValueError(f"setup move {x},{y}={c!r} rejected by Board")
+    return None
+
+
