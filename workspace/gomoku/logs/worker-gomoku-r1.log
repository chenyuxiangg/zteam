+"""Pytest configuration and shared fixtures for the gomoku r1 tests.
+
+The tests live in a separate directory (workspace/gomoku/tests/gomoku-r1/)
+than the code being tested (workspace/gomoku/code/gomoku-r1/).  We
+make the ``gomoku`` package importable by inserting the code directory
+onto ``sys.path`` at collection time.
+
+Testplan mapping: see workspace/gomoku/testplans/gomoku-r1.md §3 / §4.
+"""
+from __future__ import annotations
+
+import os
+import sys
+from pathlib import Path
+
+import pytest
+
+
+# ----------------------------------------------------------------------------
+# sys.path bootstrap: ensure ``import gomoku`` resolves to the code-r1 dir.
+# ----------------------------------------------------------------------------
+_REPO_ROOT = Path(__file__).resolve().parents[2]  # workspace/gomoku/tests/gomoku-r1/tests -> gomoku
+_CODE_DIR = _REPO_ROOT.parent.parent.parent / "code" / "gomoku-r1"
+# Above resolves to workspace/gomoku/code/gomoku-r1 (the code-stage product).
+
+if not _CODE_DIR.is_dir():
+    raise RuntimeError(
+        f"code directory not found: {_CODE_DIR}.  Did the code-stage layout change?"
+    )
+
+_CODE_DIR_STR = str(_CODE_DIR)
+if _CODE_DIR_STR not in sys.path:
+    sys.path.insert(0, _CODE_DIR_STR)
+
+
+@pytest.fixture(scope="session")
+def code_dir() -> Path:
+    """Path to the code-stage directory containing the gomoku package."""
+    return _CODE_DIR
+
+
+# ----------------------------------------------------------------------------
+# Reusable board factories (testplan §4 "数据准备").
+# ----------------------------------------------------------------------------
