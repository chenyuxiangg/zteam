+"""完整整局自检（不进交付物）。"""
+import sys
+import time
+sys.path.insert(0, ".")
+
+from gomoku.board import Board
+from gomoku.ai import choose_move
+from gomoku.config import Config
+from gomoku.main import play_one_game, parse_args
+from gomoku.ui import UI
+
+
+class FakeUI:
+    """模拟 UI：把 get_move 注入一系列坐标；不实际打印。"""
+
+    def __init__(self, size: int, moves: list[str]) -> None:
+        self.size = size
+        self.moves = list(moves)
+        self.last_render = None
+        self.message = None
+        self.ask_restart_return = False
+        self._win = None
+        self._msg = ""
+
+    def render(self, board, turn, last_move=None, message="", over=False, winner=None):
+        self.last_render = (board, turn, last_move, message, over, winner)
+
+    def get_move(self, board):
+        if not self.moves:
+            raise KeyboardInterrupt
+        nxt = self.moves.pop(0)
+        return board.parse_move(nxt)
+
+    def show_message(self, msg):
+        pass
+
+    def show_winner(self, winner, message=""):
+        self._win = winner
+        self._msg = message
+
+    def ask_restart(self):
+        return self.ask_restart_return
+
+
+def test_full_game_easy():
+    """黑（人类）摆 5 连胜。"""
+    cfg = Config(size=15, difficulty="weak", forbidden="off", human_color="B")
+    # 黑连续 4 子 + 1 子胜
+    moves = ["A8", "A1", "B8", "B1", "C8", "C1", "D8", "D1", "E8"]  # 黑第 5 子在 E8 胜
+    ui = FakeUI(15, moves)
+    play_one_game(ui, cfg)
+    assert ui._win == "B", f"应黑胜，got {ui._win}"
+    print("整局黑胜 OK")
+
+
+def test_full_game_forbidden():
+    """黑走双三禁手：白胜。"""
+    cfg = Config(size=15, difficulty="weak", forbidden="on", human_color="B")
+    # 摆出双三禁手：先放横 B B 空 B（摆 (3,4)(4,4)(6,4)），中心 (5,4) 落子形成
+    # 横向 BB.B + 中心 B = 跳活三；+ 竖直 BB空 B（摆 (5,2)(5,3) B、(5,5) B 中心 5,4 落子）= 直活三
+    # 但 AI 执白，会选择封堵；为简化，让 AI 弱档忽略威胁，专注于自己下
+    # 实际：黑连续下 (3,4)(4,4)(6,4)，再 (5,2)(5,3)(5,5)，再 (5,4) = 双三
+    moves = [
+        "D5", "A1",  # 黑 3,4 → 字符 D5
+        "E5", "A2",
+        "G5", "A3",
+        "E3", "A4",  # 5,2 → E3
+        "E4", "A5",  # 5,3 → E4
+        "E6", "A6",  # 5,5 → E6
+        "E5", "A7",  # 5,4 → E5  ← 黑落 E5 双三禁手
+    ]
+    ui = FakeUI(15, moves)
+    play_one_game(ui, cfg)
+    # 黑方禁手：白胜
+    assert ui._win == "W", f"应白胜（黑禁手），got {ui._win} msg={ui._msg}"
+    print("整局禁手 OK")
+
+
