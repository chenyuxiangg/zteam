+            "已有 4 B in row；放第 5 子胜出；不应被禁。",
+        ),
+        _case(
+            "成五同时形成另一活三不应判禁",
+            [
+                "B .",
+                ". B",
+                "B .",
+                ". B",
+            ],
+            (1, 3), False, None,
+            "成 5 in col 1；另一活三同时存在 → 成五优先，胜出。",
+        ),
+
+        # ---- 长连 ----
+        _case(
+            "长连 6 子",
+            ["B B B B B ."],
+            (5, 0), True, "long",
+            "放第 6 子形成长连。",
+        ),
